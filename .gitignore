# Código fuente de referencia (original React de Mauricio) — solo local
reference/

# Config local de Claude Code (permisos de esta máquina) — no va al repo público.
# Los agentes y skills en .claude/ SI se versionan.
.claude/settings.local.json

# Variables de entorno: las API keys nunca deben llegar a git
.env*
.vercel

# Dependencias: se instalan desde package.json (Vercel corre npm install en cada
# despliegue), asi que no tienen por que viajar en el repo.
node_modules/
# Y SIN BARRA TAMBIÉN, que no es redundante: `node_modules/` solo casa con un
# DIRECTORIO, y en un worktree lo normal es enlazar el node_modules del repo
# principal con un symlink. Un symlink no es un directorio para git, así que
# `git add -A` se lo llevaba al índice y el enlace —con la ruta absoluta de una
# máquina concreta dentro— acababa commiteado. Pasó el 2026-09-02 y hubo que
# reescribir siete commits para sacarlo.
node_modules

# Notas de trabajo locales, no parte del sitio
instrucciones.md

# Fotos originales de los breakdowns a resolucion completa (~8 MB). El sitio
# usa las versiones de 900px que estan junto a esta carpeta; estas se guardan
# solo como respaldo local por si hay que regenerarlas con otro encuadre.
assets/breakdowns/_originales/

# Respuestas crudas de EDGAR (scripts/edgar-facts.mjs --cache)
.cache/

# Salida de Astro (Vercel la genera en cada despliegue)
dist/
.astro/

# Salida del ensayo local del boletín (scripts/boletin-ensayo.js): el correo de
# la semana en HTML para poder mirarlo antes de mandarlo. Se regenera solo.
tmp/

# Informes de Lighthouse CI (npm run check-lh). Son 18 JSON por corrida y se
# regeneran solos; en el CI se suben como artefacto del job, no al repo.
.lighthouseci/

# Andamio local de la vista previa del navegador: no es del proyecto.
.claude/launch.json
