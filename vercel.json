{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/send-newsletter",
      "schedule": "0 14 * * 0"
    }
  ],
  "functions": {
    "api/send-newsletter.js": {
      "maxDuration": 60
    },
    "api/news.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/fotos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/articles/tipo-de-cambio",
      "destination": "/lessons/peso-tipo-de-cambio",
      "permanent": true
    },
    {
      "source": "/articles/tipo-de-cambio.html",
      "destination": "/lessons/peso-tipo-de-cambio",
      "permanent": true
    },
    {
      "source": "/articles/presupuesto",
      "destination": "/lessons/presupuesto-50-30-20",
      "permanent": true
    },
    {
      "source": "/articles/presupuesto.html",
      "destination": "/lessons/presupuesto-50-30-20",
      "permanent": true
    },
    {
      "source": "/articles/ahorro-vs-inversion",
      "destination": "/lessons/errores-al-invertir",
      "permanent": true
    },
    {
      "source": "/articles/ahorro-vs-inversion.html",
      "destination": "/lessons/errores-al-invertir",
      "permanent": true
    },
    {
      "source": "/articles/:path*",
      "destination": "/#tips",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/news/:slug",
      "destination": "/news-read"
    },
    {
      "source": "/es/noticias/:slug",
      "destination": "/es/noticias-leer"
    },
    {
      "source": "/newsletter/:fecha(\\d{4}-\\d{2}-\\d{2})",
      "destination": "/newsletter-read"
    },
    {
      "source": "/es/boletin/:fecha(\\d{4}-\\d{2}-\\d{2})",
      "destination": "/es/boletin-leer"
    }
  ]
}
