{
  "name": "smartfinance-lat",
  "version": "1.0.0",
  "description": "SmartFinance.lat — educación financiera bilingüe (EN/ES) para jóvenes: mercados honestos, lecciones, research y boletín. Astro estático + funciones serverless en /api.",
  "author": "Jaime Sandoval Ricaño",
  "private": true,
  "license": "MIT",
  "homepage": "https://smartfinance.lat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaime-pixel817/smart-finance.git"
  },
  "bugs": {
    "url": "https://github.com/Jaime-pixel817/smart-finance/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "commonjs",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "test -f scripts/build-og-pages.mjs && node scripts/build-og-pages.mjs || echo '[og:pages] me salto la generacion: falta scripts/ (lo excluye .vercelignore) o el generador aviso. Se usan las imagenes commiteadas de public/og/.'",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "build:es": "node scripts/build-es.js",
    "build:email-icons": "node scripts/build-email-icons.js",
    "check-es": "node scripts/build-es.js && git diff --quiet -- es sitemap.xml || (echo /es esta desactualizado: corre npm run build:es y commitea el resultado. && exit 1)",
    "build:og": "node scripts/build-og.js",
    "build:og-pages": "node scripts/build-og-pages.mjs --strict",
    "build:og-reto": "node scripts/build-og-reto.mjs",
    "news:sync": "node scripts/news-sync.js",
    "boletin:ensayo": "node scripts/boletin-ensayo.js",
    "newsletter:sync": "node scripts/newsletter-sync.js",
    "derive": "node scripts/derive.mjs",
    "check-seo": "node scripts/check-seo.mjs dist",
    "check-lh": "npx -y @lhci/cli@0.15.1 autorun --config=lighthouserc.json",
    "test": "node --test",
    "build:three": "node scripts/build-three.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/preact": "^5.1.5",
    "astro": "^6.4.8",
    "lightweight-charts": "^5.2.1",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "wawoff2": "^2.0.1",
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3",
    "three": "0.150.1",
    "rollup": "^4.52.5",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4"
  }
}
