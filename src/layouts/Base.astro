---
// Layout base de Smart Finance 2.0: head completo (title, description,
// canonical, hreflang EN/ES/x-default desde src/i18n/routes.ts, Open Graph,
// JSON-LD), preload de fuentes, tema antes del primer pintado, barra superior,
// bottom nav móvil, overlay de búsqueda y footer con disclaimer.
import '../styles/base.css';
import type { Locale } from '../i18n/routes';
import { alternates, route, SITE } from '../i18n/routes';
import { grafo } from '../lib/jsonld';
import { useT } from '../i18n/ui';
import SkipLink from '../components/SkipLink.astro';
import TopBar from '../components/TopBar.astro';
import BottomNav from '../components/BottomNav.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import Footer from '../components/Footer.astro';
import Avisos from '../components/Avisos.astro';

interface Props {
  locale: Locale;
  routeId: string;
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  /** id de la pestaña activa del nav: today | markets | news | learn */
  active?: string;
  jsonLd?: Record<string, unknown>;
  /** og:type: website (por defecto) o article en lecciones y research */
  ogType?: 'website' | 'article';
  /**
   * La barra flota TRANSPARENTE sobre el contenido en vez de ocupar su hueco.
   * Solo lo pide el home, cuyo hero lleva el globo a sangre hasta el borde de
   * arriba (ver src/components/home/Hero.astro).
   */
  heroOverlay?: boolean;
}
const { locale, routeId, title, description, active = 'today', jsonLd, ogType = 'website', heroOverlay = false } = Astro.props;
const t = useT(locale);
const alts = alternates(routeId);
const canonical = SITE + route(routeId, locale);
const ogImage = Astro.props.ogImage ?? (locale === 'es' ? SITE + '/og-image-es.jpg' : SITE + '/og-image.jpg');
const ogImageAlt = Astro.props.ogImageAlt ?? title;
// JSON-LD: el nodo de la página (el que ella pasa, o un WebSite por defecto)
// dentro de un @graph con la Organization y la Person del sitio, más las migas
// si la ruta cuelga de una sección. Ver src/lib/jsonld.ts: hasta ahora cuarenta
// páginas apuntaban a un '#organization' que no existía en ningún documento.
const nodoPagina = jsonLd ?? {
  '@type': 'WebSite',
  name: 'Smart Finance',
  url: SITE + '/',
  description,
  inLanguage: locale === 'es' ? 'es-MX' : 'en',
  publisher: { '@id': SITE + '/#organization' }
};
const ld = grafo(locale, routeId, title, nodoPagina);
const FAVICON = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%2309090B'/%3E%3Ctext x='16' y='23' font-family='Georgia,serif' font-size='20' font-weight='bold' fill='%2316C47F' text-anchor='middle'%3ES%3C/text%3E%3C/svg%3E";
---
<!doctype html>
<html lang={locale === 'es' ? 'es' : 'en'}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#09090B" media="(prefers-color-scheme: dark)">
  <meta name="theme-color" content="#F7F7F4" media="(prefers-color-scheme: light)">
  <link rel="canonical" href={canonical}>
  {alts.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
  <link rel="icon" href={FAVICON}>
  <meta property="og:type" content={ogType}>
  <meta property="og:site_name" content="Smart Finance">
  <meta property="og:locale" content={locale === 'es' ? 'es_MX' : 'en_US'}>
  <meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_MX'}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={ogImageAlt}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  <!-- Preload de las TRES fuentes del primer pintado. Fraunces faltaba y es la
       del titular de cada página (.t-display / .t-h1): con font-display: swap
       el titular se pintaba en la serif del sistema y saltaba al llegar la
       buena, moviendo todo lo de abajo. En /research/lululemon eso eran 0.22
       de CLS medidos con datos reales, once veces el presupuesto. Pesa 18 KB,
       la mitad que Geist 400. -->
  <link rel="preload" href="/assets/fonts/geist-sans-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/geist-mono-500.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/fraunces-600.woff2" as="font" type="font/woff2" crossorigin>
  <!-- Tema ANTES del primer pintado: dark por defecto; la elección guardada
       gana. Sin JS, :root queda sin data-theme y manda prefers-color-scheme. -->
  <script is:inline>
    (function(){try{var t=localStorage.getItem('sf-theme');document.documentElement.setAttribute('data-theme',t==='light'?'light':'dark');}catch(e){document.documentElement.setAttribute('data-theme','dark');}})();
  </script>
  <!-- Idioma: recuerda la elección y, solo en la raíz, respeta lo guardado
       (mismo script que el sitio legacy, así las dos mitades coinciden). -->
  <script is:inline src="/assets/lang.js"></script>
  <!-- Analítica sin cookies: Vercel Web Analytics (visitas y los once eventos
       de src/lib/analytics.ts) y Speed Insights (Core Web Vitals de visitas
       reales). Los dos scripts los sirve el propio dominio desde /_vercel/, no
       ponen cookies y no guardan identificadores.

       SI EL NAVEGADOR DICE QUE NO, NO SE CARGA NADA: se mira Global Privacy
       Control y Do Not Track ANTES de inyectarlos, así que no es que se manden
       menos datos, es que no hay ni petición. En local los dos archivos no
       existen (los pone Vercel) y el sitio funciona igual: `va` se queda sin
       definir y `medir()` no hace nada.

       La cola `va`/`vaq` va antes del script porque un evento puede salir
       mientras todavía está descargándose. Ver /methodology → "Analítica". -->
  <script is:inline>
    (function () {
      try {
        var n = navigator;
        if (n.globalPrivacyControl === true || n.doNotTrack === '1' || window.doNotTrack === '1' || n.msDoNotTrack === '1') return;
        window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
        var rutas = ['/_vercel/insights/script.js', '/_vercel/speed-insights/script.js'];
        for (var i = 0; i < rutas.length; i++) {
          var s = document.createElement('script');
          s.defer = true; s.src = rutas[i];
          document.head.appendChild(s);
        }
      } catch (e) { /* sin analítica, el sitio va igual */ }
    })();
  </script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)}></script>
  <slot name="head" />
</head>
<body>
  <SkipLink locale={locale} />
  <TopBar locale={locale} routeId={routeId} active={active} overlay={heroOverlay} />
  <main id="main" tabindex="-1" class:list={[heroOverlay && 'main-hero']}>
    <slot />
  </main>
  <Footer locale={locale} routeId={routeId} />
  <BottomNav locale={locale} active={active} />
  <SearchOverlay locale={locale} />
  <!-- Avisos contextuales: va al final del <body> y flota por encima de la
       barra de abajo, nunca sobre ella. En las páginas sin ningún aviso
       posible no pinta nada (src/lib/avisos/avisos.mjs). -->
  <Avisos locale={locale} routeId={routeId} />
  <!-- ENTRADA POR SCROLL. Va aquí, en línea y al final del <body>, por dos
       razones que no son estilo: (1) corre DURANTE el análisis del HTML, o sea
       antes de que nadie pueda hacer scroll — un módulo diferido escondería
       bloques que el visitante ya estaba mirando; (2) siendo el guion el que
       esconde, si el JavaScript falla no queda media página con opacidad 0.
       Solo toca lo que está POR DEBAJO del pliegue: el primer pantallazo —el
       que mide el LCP— se pinta exactamente igual que sin esto. Reglas y
       porqués en src/styles/motion.css. -->
  <script is:inline>
    (function () {
      try {
        var raiz = document.getElementById('main');
        if (!raiz || !('IntersectionObserver' in window)) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var alto = window.innerHeight, esperan = [], todas = raiz.querySelectorAll('section');
        for (var i = 0; i < todas.length; i++) {
          var s = todas[i];
          // Solo bloques HOJA: una sección que contiene secciones anima por
          // dentro, no entera (si no, media página sube de golpe).
          if (s.hasAttribute('data-no-reveal') || s.querySelector('section')) continue;
          if (s.getBoundingClientRect().top < alto) continue;
          s.classList.add('sf-out');
          esperan.push(s);
        }
        if (!esperan.length) return;
        var io = new IntersectionObserver(function (entradas) {
          var v = entradas.filter(function (e) { return e.isIntersecting; });
          // Los que entran a la vez se escalonan de arriba abajo y de izquierda
          // a derecha; el que entra solo no espera nada.
          v.sort(function (a, b) {
            var d = a.boundingClientRect.top - b.boundingClientRect.top;
            return Math.abs(d) > 4 ? d : a.boundingClientRect.left - b.boundingClientRect.left;
          });
          v.forEach(function (e, k) {
            var el = e.target;
            el.style.setProperty('--sf-i', Math.min(k, 4));
            el.classList.remove('sf-out');
            el.classList.add('sf-in');
            io.unobserve(el);
            // Al terminar se limpia: un `transform` vivo en una sección
            // convertiría a esa sección en el bloque de referencia de
            // cualquier `position: fixed` que llegue a colgar de ella.
            el.addEventListener('transitionend', function () {
              this.classList.remove('sf-in');
              this.style.removeProperty('--sf-i');
            }, { once: true });
          });
        }, { rootMargin: '0px 0px -8% 0px' });
        esperan.forEach(function (el) { io.observe(el); });
      } catch (e) { /* sin entrada por scroll, la página se lee igual */ }
    })();
  </script>
</body>
</html>
