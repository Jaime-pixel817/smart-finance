---
// Price chart panel (sección C): readout (precio mono 32, Δ ▲▼, fecha y hora
// bajo el dedo), pestañas de rango con role=tablist, línea de sesión ("Última
// sesión · viernes 21 de agosto · barras de 5 min"), lienzo 200/280/320 px que
// reserva su alto (CLS 0), línea de estado (sin datos · error), chip de fuente
// y atribución a TradingView. El dibujo lo monta src/scripts/chart-panel.ts
// (Lightweight Charts, import dinámico), que también mete dentro del lienzo la
// capa transparente del arrastre (.pp-hit).
import type { Locale } from '../../i18n/routes';
import { useT, type UIKey } from '../../i18n/ui';
import { RANGES, type Range } from '../../scripts/market-data';
import SourceChip from '../SourceChip.astro';

interface Props { locale: Locale; id: string; ranges?: Range[]; range?: Range; source?: string; delay?: number; class?: string }
const { locale, id, ranges = RANGES, range = '1D', source = 'Yahoo Finance', delay, class: cls } = Astro.props;
const t = useT(locale);
---
<div class:list={['pp', cls]} id={id} data-price-panel data-range={range} data-state="loading" data-chart="pending">
  <div class="pp-head">
    <div class="pp-readout">
      <p class="pp-price num skel">0,000.00</p>
      <p class="pp-sub">
        <span class="pp-chg num t-small skel">▲ 0.00 (0.00 %)</span>
        <span class="pp-when t-caption faint skel">Thu 21 Aug · 1D</span>
      </p>
    </div>
    <div class="pp-ranges" role="tablist" data-slide aria-label={t('range.aria')}>
      {ranges.map((r) => (
        <button type="button" role="tab" data-range={r} aria-selected={r === range ? 'true' : 'false'} tabindex={r === range ? 0 : -1}>{t(('range.' + r) as UIKey)}</button>
      ))}
    </div>
  </div>
  <p class="pp-session t-caption faint"></p>
  <!-- El aviso de "sin datos" va ENCIMA del lienzo, no antes: apareciendo como
       un renglón nuevo empujaba la gráfica y media página hacia abajo (0.18 de
       CLS medido en /market/spy con el endpoint caído, que es justo cuando el
       aviso sale). Encima del hueco que ya estaba reservado no mueve nada, y
       además es donde tiene sentido leerlo. Va fuera del lienzo —que es
       aria-hidden— para que role="status" siga anunciándose. -->
  <div class="pp-plot">
    <div class="pp-canvas skel" aria-hidden="true"></div>
    <p class="pp-state t-caption" role="status" hidden></p>
  </div>
  <div class="pp-foot">
    <SourceChip locale={locale} class="pp-chip" source={source} delay={delay} note={t('src.bars5')} />
    <a class="pp-tv t-caption" href="https://www.tradingview.com/" target="_blank" rel="noopener">{t('chart.by')} TradingView ↗</a>
  </div>
</div>
<style>
  .pp { display: flex; flex-direction: column; gap: var(--sp-3); min-width: 0; }
  .pp-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--sp-3); }
  .pp-readout { min-width: 0; }
  .pp-price { font-family: var(--font-mono); font-weight: 500; font-size: var(--fs-num-xl); line-height: 1.1; letter-spacing: -.01em; font-variant-numeric: tabular-nums slashed-zero; min-width: 6ch; white-space: nowrap; }
  .pp-sub { display: flex; gap: var(--sp-2); align-items: baseline; flex-wrap: wrap; margin-top: 4px; min-height: 1.25rem; }
  .pp-chg { min-width: 9ch; white-space: nowrap; }
  .pp-when { min-width: 8ch; white-space: nowrap; }
  /* El lavado de la pestaña elegida ya no lo pinta la pestaña: lo pinta la
     marca deslizante del grupo (--tab-r le da su radio). Ver motion.css. */
  .pp-ranges { display: inline-flex; gap: 2px; padding: 2px; background: var(--bg-2); border: 1px solid var(--line); border-radius: var(--r-btn); --tab-r: 8px; }
  .pp-ranges [role="tab"] { min-width: 44px; height: 36px; padding: 0 10px; border-radius: 8px; font-family: var(--font-mono); font-size: var(--fs-caption); font-weight: 500; color: var(--ink-2); transition: color var(--dur-2) var(--ease-std); }
  .pp-ranges [role="tab"]:hover { color: var(--ink); }
  .pp-ranges [role="tab"][aria-selected="true"] { color: var(--ink); }
  /* Qué sesión se está viendo. Ocupa su renglón desde el primer pintado para
     que la gráfica no salte cuando llega el dato. */
  .pp-session { color: var(--ink-2); min-height: 1rem; }
  .pp-plot { position: relative; }
  .pp-state { position: absolute; inset: 0; z-index: 3; display: grid; place-items: center; text-align: center; padding: 0 var(--sp-4); color: var(--warn); margin: 0; }
  .pp-state[hidden] { display: none; }
  .pp[data-state="error"] .pp-state { color: var(--down-text); }
  .pp[data-state="empty"] .pp-state { color: var(--ink-2); }
  .pp-canvas { display: block; position: relative; width: 100%; height: 200px; border-radius: var(--r-input); touch-action: pan-y; overflow: hidden; }
  .pp-canvas.skel { background: var(--bg-2); }
  /* Capa del arrastre: se queda con los eventos de puntero para que el lector
     siga al dedo desde el primer píxel (Lightweight Charts, en táctil, pide
     una pulsación larga antes de mover nada). `pan-y` deja que el gesto
     vertical siga desplazando la página. */
  /* El lienzo y sus etiquetas viven aquí dentro; es lo que el trazado
     destapa de izquierda a derecha (src/styles/trazo.css). La capa del
     arrastre se queda fuera a propósito: un clip-path recorta también los
     eventos de puntero. */
  .pp-canvas :global(.pp-draw) { position: absolute; inset: 0; }
  /* Etiquetas del máximo y del mínimo del periodo: van en HTML y no en el
     marcador de la librería, que recorta su texto contra el borde del panel. */
  .pp-canvas :global(.pp-tags) { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  .pp-canvas :global(.pp-tag) { position: absolute; transform: translateX(-50%); font-family: var(--font-mono); font-size: 11px; line-height: 1; white-space: nowrap; }
  .pp-canvas :global(.pp-tag.hi) { color: var(--up-text); }
  .pp-canvas :global(.pp-tag.lo) { color: var(--down-text); }
  .pp-canvas :global(.pp-hit) { position: absolute; inset: 0; z-index: 2; touch-action: pan-y; cursor: crosshair; -webkit-user-select: none; user-select: none; -webkit-tap-highlight-color: transparent; }
  .pp[data-loading="1"] .pp-canvas { opacity: .7; transition: opacity .15s; }
  @media (min-width: 768px) { .pp-canvas { height: 280px; } }
  @media (min-width: 1024px) { .pp-canvas { height: 320px; } }
  .pp-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--sp-2) var(--sp-4); }
  .pp-foot :global(.src-chip) { flex-wrap: wrap; row-gap: 2px; }
  /* «Gráfica por TradingView ↗» son tres palabras que sí pueden repartirse en
     dos renglones; con `nowrap` pedían un renglón entero y a 225 % se salían
     44 px. La atribución sigue entera, solo que en dos líneas. */
  .pp-tv { color: var(--ink-3); min-height: 28px; display: inline-flex; align-items: center; }
  .pp-tv:hover { color: var(--ink); }
  @media (prefers-reduced-motion: reduce) { .pp[data-loading="1"] .pp-canvas { transition: none; } }
</style>
<script>
  // Solo mide y coloca la marca deslizante de las pestañas de rango; el panel
  // lo sigue moviendo chart-panel.ts, que ni se entera de que esto existe.
  import '../../scripts/tabs';
</script>
