---
// Asset row (sección C): 56 px, símbolo + nombre · sparkline 64×24 · precio ·
// Δ con color y ▲▼. Nace con esqueletos del ancho final (sin CLS) y el script
// de la página la rellena por data-row. Toda la fila es el enlace a la ficha.
// Las tasas (sin cotización) se pintan ya en el servidor: valor y fecha de
// verificación, sin sparkline.
//
// EL BOTÓN DE SEGUIR VA FUERA DEL ENLACE, no dentro: un <button> dentro de un
// <a> es HTML inválido y el teclado se lo come. Por eso el borde de la fila lo
// pinta el <li> y no el enlace. `data-row` puede repetirse (el mismo activo
// sale en "Lo que sigues" y en su sección), así que los scripts pintan TODAS
// las filas que casan, no la primera.
import '../../styles/trazo.css';
import type { Locale } from '../../i18n/routes';
import { useT } from '../../i18n/ui';
import { sectionOf, type SymbolEntry } from '../../data/symbols';

interface Props {
  locale: Locale; s: SymbolEntry; href: string;
  rate?: { value: string; note: string; verified: string };
  /** Botón de seguir/dejar de seguir (todo menos las tasas, que no cotizan). */
  seguible?: boolean;
  /** Nace escondida: las filas de "Lo que sigues" las enciende el script. */
  oculta?: boolean;
}
const { locale, s, href, rate, seguible = false, oculta = false } = Astro.props;
const t = useT(locale);
const name = s.name[locale] + (s.note ? ' · ' + s.note[locale] : '');
const nombreSolo = s.name[locale];
---
<li class="ar" data-row={s.id} data-kind={sectionOf(s)} data-state={rate ? 'ready' : 'loading'} hidden={oculta}>
  <a class="ar-link" href={href}>
    <span class="ar-id">
      <span class="ar-sym num">{s.sym}</span>
      <span class="ar-name t-caption faint">{name}</span>
    </span>
    {rate ? (
      <span class="ar-spark ar-rate-note t-caption faint">{rate.note}</span>
    ) : (
      <span class="ar-spark" aria-hidden="true"><svg class="spark trazo-destape skel" viewBox="0 0 64 24" preserveAspectRatio="none"><path class="line" d=""></path></svg></span>
    )}
    {rate ? (
      <span class="ar-price num">{rate.value}</span>
    ) : (
      <span class="ar-price num skel">0,000.00</span>
    )}
    {rate ? (
      <span class="ar-chg t-caption faint ar-verified">{rate.verified}</span>
    ) : (
      <span class="ar-chg num t-caption skel">▲ 0.00 %</span>
    )}
  </a>
  {seguible && !rate && (
    <button class="ar-follow" type="button" data-follow={s.id} aria-pressed="false"
      aria-label={t('watch.follow') + ' ' + nombreSolo}
      data-label-on={t('watch.unfollow') + ' ' + nombreSolo}
      data-label-off={t('watch.follow') + ' ' + nombreSolo}>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path d="M6.5 3.5h11a1 1 0 0 1 1 1v16l-6.5-3.8L5.5 20.5v-16a1 1 0 0 1 1-1z"
          fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
      </svg>
    </button>
  )}
</li>
<style>
  .ar { display: flex; align-items: center; border-bottom: 1px solid var(--line); }
  .ar[hidden] { display: none; }
  .ar:last-child { border-bottom: 0; }
  .ar-link { flex: 1 1 auto; min-width: 0; display: grid; grid-template-columns: minmax(0, 1fr) 64px auto auto; align-items: center; gap: var(--sp-3); min-height: 56px; padding: 0 var(--sp-2); color: var(--ink); transition: background .15s; }
  /* El fondo de hover/seleccionada va en la FILA, no en el enlace: con el
     botón de seguir fuera del <a>, pintarlo en el enlace dejaba una costura
     justo antes del marcador. */
  .ar:hover, .ar[aria-current] { background: var(--bg-2); border-radius: var(--r-input); }
  .ar-link:active { transform: scale(.995); }
  .ar[aria-current] .ar-sym { color: var(--brand-text); }
  .ar-id { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .ar-sym { font-size: var(--fs-small); }
  .ar-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ar-spark { width: 64px; height: 24px; display: block; }
  .ar-rate-note { height: auto; white-space: nowrap; text-align: right; justify-self: end; }
  .ar-price { font-size: var(--fs-small); text-align: right; min-width: 7ch; white-space: nowrap; }
  .ar-chg { text-align: right; min-width: 8ch; white-space: nowrap; }
  .ar-verified { min-width: 0; }

  /* Seguir: 44×44 de zona táctil, marcador vacío cuando no lo sigues y
     relleno cuando sí. NO se pone verde al seguir: el verde de este sitio
     significa "sube", y en la misma fila hay un ▲ verde. Un marcador verde al
     lado de un cambio verde se lee como parte del dato. Relleno en color de
     tinta: lo que cambia es la forma, no el significado. */
  .ar-follow { flex: 0 0 auto; display: grid; place-items: center; width: 44px; height: 44px; margin-right: -8px; background: none; border: 0; border-radius: var(--r-btn); color: var(--ink-3); cursor: pointer; transition: color .15s, background .15s; }
  .ar-follow:hover { color: var(--ink); background: var(--bg-2); }
  .ar-follow[aria-pressed="true"] { color: var(--ink-2); }
  .ar-follow[aria-pressed="true"] svg path { fill: currentColor; }
  .ar-follow:focus-visible { box-shadow: var(--focus-ring); outline: none; }

  @media (max-width: 479px) { .ar-link { gap: var(--sp-2); padding-left: var(--sp-1); } .ar-follow { width: 40px; } }
  @media (min-width: 768px) { .ar-price { min-width: 9ch; } .ar-chg { min-width: 9ch; } }
  /* Al estrecharse mucho (≤ 380 px), la sparkline de las filas cede antes que
     el precio: primero se va el dibujo, nunca el número ni el botón. */
  @media (max-width: 379px) { .ar-link { grid-template-columns: minmax(0, 1fr) auto auto; gap: var(--sp-2); } .ar-spark:not(.ar-rate-note) { display: none; } }
</style>
