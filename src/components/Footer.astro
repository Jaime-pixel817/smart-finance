---
import type { Locale } from '../i18n/routes';
import { route, otherLocale } from '../i18n/routes';
import { useT } from '../i18n/ui';
const { locale, routeId } = Astro.props as { locale: Locale; routeId: string };
const t = useT(locale);
const other = otherLocale(locale);
let altHref = route('home', other);
try { altHref = route(routeId, other); } catch {}
const home = route('home', locale);
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <p class="footer-brand">Smart Finance</p>
        <p class="t-small muted">{t('site.tagline')}.</p>
      </div>
      <nav class="footer-nav" aria-label={locale === 'es' ? 'Pie de página' : 'Footer'}>
        <a href={home}>{t('nav.today')}</a>
        <a href={route('market', locale)}>{t('nav.markets')}</a>
        <a href={route('news', locale)}>{t('nav.news')}</a>
        <a href={route('lessons', locale)}>{t('nav.learn')}</a>
        <a href={route('research', locale)}>{t('nav.projects')}</a>
        <a href={route('portfolio', locale)}>{t('nav.portfolio')}</a>
        <a href={route('actinver', locale)}>{t('nav.actinver')}</a>
        <a href={route('lessons.glossary', locale)}>{t('nav.glossary')}</a>
        <a href={route('tools', locale)}>{t('nav.tools')}</a>
        <a href={route('challenge', locale)}>{t('nav.challenge')}</a>
        <!-- Al ÍNDICE del boletín, no al formulario del home: ahora es una
             página con los números anteriores y su propio botón de alta, así
             que enlazar aquí enseña qué se recibe antes de pedir el correo.
             El botón de la barra superior sí sigue yendo directo al alta. -->
        <a href={route('newsletter', locale)}>{t('nav.newsletter')}</a>
      </nav>
      <nav class="footer-nav" aria-label={locale === 'es' ? 'Sitio y redes' : 'Site and social'}>
        <a href={route('about', locale)}>{t('nav.about')}</a>
        <a href={route('methodology', locale)}>{t('nav.methodology')}</a>
        <a href="https://www.linkedin.com/in/jaime-sandoval-ricano-23b3a4401" target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href="https://www.tiktok.com/@smart.financee" target="_blank" rel="noopener">TikTok ↗</a>
        <a href={route('community', locale)}>{t('footer.community')}</a>
        <a class="lang-btn" data-lang={other} href={altHref} hreflang={other} lang={other}>{t('footer.language')}: {t('nav.lang.switch')}</a>
      </nav>
    </div>
    <p class="disclaimer">{t('footer.disclaimer')}</p>
    <p class="t-caption faint">{t('footer.rights')} · {t('footer.made')}</p>
  </div>
</footer>
<style>
  .footer { border-top: 1px solid var(--line); padding: var(--sp-6) 0 var(--sp-6); margin-top: var(--sp-6); color: var(--ink-2); }
  /* `1fr` NO es «una fracción y ya»: su mínimo implícito es `auto`, o sea el
     min-content de la columna. Con el texto del navegador al 200 %, «Metodología»
     mide más que media caja y las dos columnas se negaban a encoger: el pie
     empujaba la página entera 93 px de lado, y como el pie está en `Base.astro`,
     eso pasaba en las 101 páginas. `minmax(0, 1fr)` le quita ese suelo; a tamaño
     normal el contenido cabe, así que se pinta idéntico.
     Quitar el suelo evita el desbordamiento, pero deja dos columnas demasiado
     estrechas para leerlas. La válvula las junta en una: es el `17em` de
     `Mesa.astro` —«ya no caben dos cosas en el mismo renglón: se parte»— y se
     reusa aquí a propósito, porque es la misma decisión. En `em` la consulta
     mide TEXTO: a 320 px son 20em al 100 % (no dispara, con 3em de margen) y
     10em al 200 % (dispara). Por eso el umbral tiene que quedarse por debajo de
     20em, que es el teléfono más estrecho a tamaño normal. */
  .footer-grid { display: grid; gap: var(--sp-4); grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); margin-bottom: var(--sp-5); }
  .footer-grid > div:first-child { grid-column: 1 / -1; }
  @media (min-width: 768px) { .footer-grid { grid-template-columns: 2fr 1fr 1fr; } .footer-grid > div:first-child { grid-column: auto; } }
  @media (max-width: 17em) { .footer-grid { grid-template-columns: minmax(0, 1fr); } }
  .footer-brand { font-family: var(--font-serif); font-weight: 600; font-size: 1.125rem; color: var(--ink); }
  .footer-nav { display: flex; flex-direction: column; gap: 2px; }
  .footer-nav a { min-height: 36px; display: inline-flex; align-items: center; font-size: var(--fs-small); color: var(--ink-2); }
  .footer-nav a:hover { color: var(--ink); }
  .disclaimer { font-size: var(--fs-caption); line-height: var(--lh-caption); color: var(--ink-3); max-width: var(--measure); margin-bottom: var(--sp-3); }
</style>
