---
// UN HUECO DE MATERIAL: el dato que no falta por escribir, falta por LLEGAR.
//
// `Hueco.astro` pide una FRASE a Jaime («lo que solo él puede escribir»).
// Esto pide otra cosa: un enlace, una foto, un cargo, un minuto — material que
// existe fuera del repo y que él tiene que pasar. La diferencia importa porque
// la instrucción es distinta: uno se rellena escribiendo en `cv.ts`, el otro se
// rellena dejando un archivo en una carpeta.
//
// Por eso este componente pinta DOS cosas y no una:
//   · la pregunta exacta, en sus términos;
//   · DÓNDE dejarlo, con la ruta literal de la carpeta.
// Rellenarlo tiene que ser cambiar un dato, no reconstruir un capítulo.
//
// SE VE QUE FALTA, igual que el otro: borde discontinuo y rótulo en mono. Un
// hueco disimulado es peor que no tenerlo — alguien mandaría el enlace creyendo
// que la página está terminada.
//
// LA CARPETA NO ES DECORATIVA: `cv-material/pendiente/<slug>/` existe (vacía) y
// `cv-material/PENDIENTE.md` la nombra. Si aquí se escribe una ruta que no
// existe, la instrucción es peor que ninguna.
import type { CvCopy } from '../../i18n/cv';

interface Props { c: CvCopy; que: string; pregunta: string; carpeta?: string; class?: string }
const { c, que, pregunta, carpeta, class: cls } = Astro.props;
---
<div class:list={['hueco-mat', cls]} role="note" aria-label={`${c.materialHueco.tag}: ${que}`}>
  <p class="hueco-mat-marca" aria-hidden="true">{c.materialHueco.tag}</p>
  <p class="hueco-mat-que" aria-hidden="true">{que}</p>
  <p class="hueco-mat-preg">{pregunta}</p>
  {carpeta && <p class="hueco-mat-donde"><span aria-hidden="true">↳ </span><code>{carpeta}</code></p>}
</div>

<style>
  .hueco-mat {
    border: 1px dashed var(--cvh-tinta-3);
    border-radius: 10px;
    padding: var(--sp-3);
    display: flex; flex-direction: column; gap: 6px;
    max-width: 34rem;
  }
  .hueco-mat-marca {
    font-family: var(--font-mono); font-size: var(--cvh-etiqueta);
    letter-spacing: .16em; text-transform: uppercase; color: var(--cvh-tinta-3);
  }
  .hueco-mat-que { font-weight: 600; color: var(--cvh-tinta); }
  .hueco-mat-preg { color: var(--cvh-tinta-2); font-size: var(--fs-caption); line-height: 1.5; }
  .hueco-mat-donde { font-size: var(--fs-caption); color: var(--cvh-tinta-3); }
  .hueco-mat-donde code {
    font-family: var(--font-mono); font-size: .95em;
    overflow-wrap: anywhere;
  }
</style>
