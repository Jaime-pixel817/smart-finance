// ------------------------------------------------------------- el índice
// EL ORDEN ES EL QUE PIDIÓ JAIME (ver la cabecera). Esta lista es la única
// fuente del índice Y de la numeración: el total se CUENTA de aquí en vez de
// escribirse, que es como "01 / 11" sobrevivió a un capítulo de menos en la
// versión anterior de este archivo hasta que alguien lo vio.
const capitulos = [
  c.caps.c1, c.caps.c2, c.caps.c3, c.caps.c4,
  c.caps.c5, c.caps.c6, c.caps.c7, c.caps.c8, c.caps.c9
];
// Los DOS lados van con dos dígitos («01 / 09», no «01 / 9»): con el índice
// relleno y el total a pelo, el rótulo cambiaba de forma según el lado
// (2026-08-29). Si algún día hay 10+ capítulos, el formato ya está listo.
const num = (i: number) => String(i + 1).padStart(2, '0') + ' / ' + String(capitulos.length).padStart(2, '0');

// ── El resumen del índice se CUENTA, no se escribe ──────────────────────
// «{n} capítulos» sale de capitulos.length — la MISMA lista que numera las
// pantallas — y «{min} minutos» de contar las palabras de la copia real del
// panel (`c` es de donde sale toda la PROSA pintada). A 200 palabras por
// minuto, lectura adulta en silencio; las lecciones no tienen una constante
// que reutilizar (su readingMinutes va escrito a mano en el frontmatter).
// Contrastado contra la página pintada (2026-08-29, innerText del panel EN
// en Chromium): 2 722 palabras visibles contra ~2 400 de esta cuenta — el
// resto son fichas de la interfaz («01 / 09», los años sueltos, cifras
// calculadas), que se miran, no se leen, así que quedarse con la prosa da
// el estimado más honesto. Antes decía «about 7 minutes» a mano: una cifra
// inventada al lado de una numeración contada.
const palabras = (o: unknown): number =>
  typeof o === 'string' ? (o.match(/\S+/g) || []).length
  : Array.isArray(o) ? o.reduce((n: number, x) => n + palabras(x), 0)
  : o && typeof o === 'object' ? Object.values(o).reduce((n: number, x) => n + palabras(x), 0)
  : 0;
const minutosLectura = Math.round(palabras(c) / 200);
const resumenIndice = c.indice.resumen
  .replace('{n}', String(capitulos.length))
  .replace('{min}', String(minutosLectura));
