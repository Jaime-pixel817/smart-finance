  /* ---- La frase ---- */
  .cap-frase { justify-content: center; gap: var(--sp-6); }
  .frase { margin: 0; }
  .frase p {
    font-family: var(--font-serif); font-weight: 600;
    font-size: var(--cvh-h-frase); line-height: 1.1; letter-spacing: -0.02em;
