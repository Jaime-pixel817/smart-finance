  <section class="cap" aria-labelledby={`${p}-cap-3-h`}>
    <span id={`${p}-cap-3`} class="cap-ancla" aria-hidden="true"></span>
    <p class="cap-num" aria-hidden="true">{num(2)}</p>
    <h2 class="cap-h" id={`${p}-cap-3-h`}>{c.caps.c3}</h2>
    {/* texto de Jaime, pendiente de su revisión final */}
    <blockquote class="voz"><p>{c.voz.servir}</p></blockquote>

    <div class="servir">
      <div class="servir-bloque">
        <h3 class="t-h3">{c.servir.bloques.animales}</h3>
        {/* El clip existe en su TikTok: se sirve desde aquí, sin bucle y
