          <span class="logo-placa"><img src={foto('reto-actinver.webp')} alt="Reto Actinver" width="182" height="108" loading="lazy" decoding="async" /></span>
          <p class="pie">{c.reto.source.replace('{d}', day(cal.fuente.consultada, locale))}</p>
