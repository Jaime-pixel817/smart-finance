    <details class="ref-plegable sf-lectura">
      <summary class="ref-ver"><span class="ref-ver-fila"><span class="ref-ver-txt">{c.dijo.el} — {pers.rendon.nombre}</span><span class="ref-flecha" aria-hidden="true"></span></span></summary>
      {dijoDe('rendon').map((q) => (
