              ? <p class="cert-cred meta-mono"><span class="faint">{c.certs.credencial}</span> {f.cred}</p>
              : f.dondeCuando
                ? <p class="cert-cred meta-mono"><span class="faint">{c.certs.sinCred}</span> {f.dondeCuando}</p>
                : <p class="cert-cred meta-mono faint">{c.certs.sinCred}</p>}
            <p class="cert-links">
              <a class="hist-link t-small" href={LINKEDIN} target="_blank" rel="noopener">{c.certs.verLinkedIn} ↗</a>
              {f.img && <a class="hist-link t-small" href={foto(f.img)} target="_blank" rel="noopener">{c.certs.verEscaneo} ↗</a>}
            </p>
          </div>
        </li>
      ))}
    </ul>


