---
// Globo de mercados, la parte en HTML: la barra de ocho chips (ciudad ·
// ▲▼Δ % · punto abierto/cerrado). Los chips van en el HTML desde el primer
// pintado (cero CLS y lista legible sin JS); src/scripts/world-markets.ts los
// rellena con /api/world y habla con el globo por eventos (world:data,
// world:select, globe:marker).
//
// DÓNDE VA: dentro del hero, justo debajo del globo (Hero.astro). No lleva
// título de sección — el "toca una ciudad" de la propia barra dice lo que hay
// que saber — ni márgenes propios: el hueco y el ancho los pone el hero, que
// la mete en su .container.
//
// DOS COSAS QUE ESTE COMPONENTE MUEVE Y NO CONTIENE. Las dos las sigue
// llevando este mismo guion (world-markets.ts), que las busca por id: cambiar
// dónde cuelgan del DOM no toca ni una línea de lógica.
//
//   #chip-world   el chip de fuente de la barra (retraso · Yahoo · hora), en
//                 Hero.astro al final del hero. Pegado debajo de los ocho
//                 chips se leía como una novena ciudad; abajo del todo se lee
//                 como el pie del hero.
//   #world-sheet  la tarjeta que se abre al tocar una ciudad, en
//                 WorldSheet.astro y montada FUERA del hero. Aquí dentro
//                 quedaba encerrada en el contexto de apilamiento de
//                 .hero-world (z-index 3) y se pintaba debajo del chip de
//                 fuente y del cuerpo de la página. La cabecera de
//                 WorldSheet.astro lo cuenta entero.
import type { Locale } from '../../i18n/routes';
import { route } from '../../i18n/routes';
import { useT } from '../../i18n/ui';
import { EXCHANGES } from '../../data/world';
import { bySymbolId, assetRouteId } from '../../data/symbols';

const { locale } = Astro.props as { locale: Locale };
const t = useT(locale);
const strings = {
  open: t('world.open'), closed: t('world.closed'), regular: t('world.regular'),
  openSr: t('world.openSr'), closedSr: t('world.closedSr'),
  loading: t('src.loading'), unavailable: t('src.unavailable')
};
// "¿Qué es este índice?": la ficha del activo si el índice está en el registro
// (S&P 500 → /market/spy); si no, la lista de /market.
const hrefOf = (asset?: string) => (asset && bySymbolId(asset) ? route(assetRouteId(asset), locale) : route('market', locale));
---
<div id="world" class="world" data-locale={locale} data-strings={JSON.stringify(strings)}>
  <p class="eyebrow world-title" id="world-title">{t('world.title')}</p>
  <ul id="world-chips" class="world-chips" role="list" aria-label={t('aria.worldList')}>
    {EXCHANGES.map((ex) => (
      <li>
        <button type="button" class="wm-chip" data-id={ex.id} data-index={ex.index} data-tz={ex.tz} data-href={hrefOf(ex.asset)} data-country-id={ex.countryId} data-country={ex.country[locale === 'es' ? 'es' : 'en']} aria-haspopup="dialog" aria-expanded="false">
          <span class="wm-dot" aria-hidden="true"></span>
          <span class="wm-city">{t(ex.cityKey)}</span>
          <span class="wm-chg num muted">—</span>
          <span class="visually-hidden wm-sr"></span>
        </button>
      </li>
    ))}
  </ul>
</div>

<style>
  /* La barra: dentro del hero, bajo el globo. Sin padding propio — la aloja
     el .container del hero, y así los chips arrancan en la misma vertical que
     el titular. */
  .world { display: flex; flex-direction: column; gap: var(--sp-2); }
  .world-chips {
    display: flex; gap: var(--sp-2); overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x proximity; -webkit-overflow-scrolling: touch; scrollbar-width: none;
    padding: 4px 0; margin: -4px 0;
    /* El desvanecido del borde dice "hay más": la fila no entra en 390 px. */
    mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent);
    -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent);
  }
  .world-chips::-webkit-scrollbar { display: none; }
  .world-chips li { flex: none; scroll-snap-align: start; }
  .wm-chip {
    position: relative; display: inline-flex; align-items: center; gap: 6px;
    min-height: 36px; padding: 0 10px 0 9px; border-radius: var(--r-pill);
    background: var(--bg-2); border: 1px solid var(--line);
    font-size: var(--fs-caption); line-height: 1; color: var(--ink); white-space: nowrap;
    -webkit-tap-highlight-color: transparent; transition: border-color .15s, background .15s;
  }
  /* 44 px de alto para el dedo sin engordar el chip a la vista. */
  .wm-chip::after { content: ''; position: absolute; left: 0; right: 0; top: -4px; bottom: -4px; }
  .wm-chip:hover { border-color: var(--ink-3); }
  .wm-chip:focus-visible { outline: none; box-shadow: var(--focus-ring); }
  .wm-chip.is-selected { background: var(--bg-3); border-color: var(--ink-2); }
  /* El punto: gris = cerrada, verde = abierta. El estado también va en texto
     para el lector de pantalla (.wm-sr), nunca solo en el color. */
  .wm-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--ink-3); flex: none; }
  .wm-chip.is-open .wm-dot { background: var(--up); box-shadow: 0 0 0 3px var(--brand-wash); }
  .wm-chg { min-width: 8ch; text-align: right; }
  @media (min-width: 768px) {
    .world-chips { flex-wrap: wrap; overflow: visible; mask-image: none; -webkit-mask-image: none; }
  }
</style>
<script src="../../scripts/world-markets.ts"></script>
