---
// EL HERO DEL HOME — el globo a sangre, el titular encima y la barra de las
// ocho bolsas justo debajo.
//
// CÓMO ESTÁ MONTADO, DE ABAJO A ARRIBA
//
//   .hero-sky     position: fixed, la banda de fondo: el degradado que hay
//                 detrás de las partículas. Se queda quieta y solo se apaga —
//                 quien viaja en la órbita es el globo. z-index 0.
//   .hero-globe   position: fixed, en el mismo sitio y del mismo tamaño que el
//                 cielo. Dentro van, superpuestos, el lienzo WebGL y el SVG de
//                 respaldo. Se funde hacia abajo con mask-image: no hay borde ni
//                 caja, el globo se disuelve en la página. z-index 1: por debajo
//                 del contenido.
//   .hero-gap     un bloque vacío que mide EXACTAMENTE hasta 24 px por debajo
//                 del marcador de São Paulo (--sao-y): el titular arranca ahí y
//                 tapa solo el casquete de abajo del planeta. Es además lo único
//                 que puede encoger si la pantalla es muy baja (ver el tope de
//                 alto del hero).
//   .hero-head    el titular, anclado por arriba: lo que crezca por debajo (la
//                 barra de bolsas) no lo mueve un píxel.
//   .hero-copy    el titular en Fraunces con la firma pegada al final de su
//                 última línea, y la línea mono con la fecha y el estado de los
//                 mercados. z-index 3, o sea encima del globo. pointer-events:
//                 none para que el dedo llegue al lienzo aunque pase por encima
//                 del texto.
//   .hero-world   la barra de bolsas (WorldMarkets.astro): "toca una ciudad" y
//                 los ocho chips. Va DENTRO del hero, en el hueco que quedaba
//                 entre la línea de estado y el final de la primera pantalla, y
//                 esta sí recibe toques. Cae por debajo del disco de partículas
//                 (que acaba bastante antes que la banda), así que va con los
//                 colores normales de la página y no con los del hero.
//   .hero-source  el chip de fuente (retraso · Yahoo · hora), empujado con
//                 margin-top: auto hasta el borde de abajo del hero. Pegado a
//                 los ocho chips se leía como una novena ciudad; aquí abajo se
//                 lee como el pie del hero.
//   .home-body    (en Home.astro) todo lo demás, opaco y también en z-index 3:
//                 al hacer scroll sube y tapa el globo.
//
// LA PRIMERA PANTALLA, MEDIDA
//
// El hero mide 100 svh MENOS --hero-peek, y dentro caben las cinco cosas que se
// abren en el teléfono: globo, titular con la firma, línea de estado, la barra
// de las ocho bolsas y el chip de fuente. Lo que asoma por debajo (--hero-peek)
// es ya el principio de .home-body, que dice que hay más página sin robarle
// sitio a nada de lo anterior.
//
// Y el conjunto globo+titular va CENTRADO en esa pantalla: --globe-top reparte
// el hueco sobrante 50/50 (a 390×844, 130 px por encima de la banda y 130 por
// debajo) y el titular arranca por debajo del marcador de São Paulo. El disco
// ocupa --globe-fill del ancho del lienzo: 80 % en el teléfono, para que quede
// aire a los lados y se lea centrado, y 85 % desde 768 px.
//
// EL SVG ESTÁTICO ES UN RESPALDO, NO EL PRIMER PINTADO. src/generated/
// globe-fallback.svg (2.3 KB, lo genera scripts/build-geo.mjs desde la máscara
// de tierra) va inline en el HTML, pero nace INVISIBLE: se veía un instante
// —del orden de medio segundo— antes de la entrada de partículas, y ese
// parpadeo sobraba. Se enciende solo cuando NO va a haber animación que
// enseñar: con prefers-reduced-motion (lo hace el CSS, desde el primer frame) o
// cuando no hay WebGL / three.js no llega (lo hace src/scripts/hero.ts). El
// hueco está reservado igual —la banda mide lo mismo esté el SVG o no—, así que
// esto no mueve nada: CLS 0.
//
// LAS PASTILLAS. Dos o tres marcadores llevan pegado su cambio del día (Nueva
// York, Ciudad de México y la bolsa que más se mueva). Las posiciones las manda
// el globo por el evento "globe:pins" —es el único que sabe dónde está cada
// punto ahora mismo— y src/scripts/hero.ts solo mueve los divs. Van con
// aria-hidden: el mismo dato, en texto y accesible, está en la barra de ocho
// chips de aquí abajo (WorldMarkets.astro).
import type { Locale } from '../../i18n/routes';
import { useT } from '../../i18n/ui';
import fallbackSvg from '../../generated/globe-fallback.svg?raw';
import WorldMarkets from './WorldMarkets.astro';
import SourceChip from '../SourceChip.astro';

const { locale } = Astro.props as { locale: Locale };
const t = useT(locale);
---
<section class="hero" aria-label={t('hero.label')}>
  <div class="hero-globe" id="hero-globe">
    <div class="hero-globe-still" aria-hidden="true" set:html={fallbackSvg} />
    <div id="globalRiskGlobe" class="globe-host" role="img" aria-label={t('globe.aria')}></div>
    <div class="hero-pins" id="hero-pins" aria-hidden="true"></div>
  </div>

  <!-- El cielo: la banda de fondo detrás de las partículas. Va FUERA de
       .hero-globe y ocupa exactamente su mismo sitio, porque durante la órbita
       el globo se encoge y el cielo no puede encogerse con él: lo que viajaba
       por la página era un rectángulo con un planeta dentro, muy visible en
       modo claro. Aquí se queda quieto y se disuelve en el primer 22 % del
       recorrido; lo que se va de viaje es la esfera sola. -->
  <div class="hero-sky" aria-hidden="true"></div>

  <!-- El hueco de encima del titular. Mide justo hasta 24 px por debajo del
       marcador de São Paulo, y es lo ÚNICO que puede encoger en el hero: si en
       una pantalla baja el contenido no cabe, cede este hueco (el titular sube)
       antes que dejar el chip de fuente debajo del bottom nav. -->
  <div class="hero-gap" aria-hidden="true"></div>

  <div class="hero-head">
    <div class="container hero-copy">
      <h1 class="hero-title">{t('site.tagline')} <span class="hero-by t-mono">{t('hero.by')}</span></h1>
      <p id="today-line" class="today-line t-mono t-caption skel" aria-live="polite">Thu 21 Aug · NYSE open · BMV open</p>
    </div>
  </div>

  <!-- La barra de bolsas, dentro del hero: es la leyenda del globo y hay que
       verla junto a él. Sin título de sección — lo que hace falta leer ahí lo
       dice ya el "toca una ciudad" de la propia barra. -->
  <div class="hero-world">
    <div class="container">
      <WorldMarkets locale={locale} />
      <p class="hero-motion t-caption faint">{t('globe.motion')}</p>
    </div>
  </div>

  <!-- El chip de fuente, al FINAL del hero y no pegado a los chips de ciudad.
       Pegado debajo de la barra de bolsas se leía como una novena ciudad; aquí
       abajo, con el hueco de por medio, se lee como lo que es: el pie de
       página del hero, la letra pequeña de todo lo que hay encima. Lo empuja
       hasta el borde de abajo el margin-top: auto (el hero es una columna
       flex), así que cae justo donde arranca el contenido de la página. -->
  <div class="hero-source">
    <div class="container">
      <SourceChip locale={locale} id="chip-world" source="Yahoo Finance" delay={15} />
    </div>
  </div>

  <!-- Dos testigos de 1 px para los IntersectionObserver de hero.ts: el de
       arriba dice cuándo la barra deja de estar sobre el globo (y se pone
       sólida) y el de abajo cuándo el globo ya aterrizó (y se apaga el bucle
       de WebGL, que si no seguiría dibujando detrás de la página). -->
  <div class="hero-mark hero-mark-top" aria-hidden="true"></div>
  <div class="hero-mark hero-mark-end" aria-hidden="true"></div>
</section>

<style>
  .hero {
    /* Lo que asoma por debajo del hero. La barra de bolsas ya va DENTRO, así
       que esto es el principio de .home-body: la frase de bienvenida y el
       encabezado del Pulso. De estos 124 px, los 56 de abajo quedan tapados
       por el bottom nav, o sea que se ven unos 68: bastante para saber que la
       página sigue, poco para robarle sitio al hero. */
    --hero-peek: 124px;
    --hero-h: calc(100svh - var(--hero-peek));
    /* La banda del globo. El disco mide --globe-fill del ANCHO del lienzo
       mientras quepa de alto, así que este alto casi nunca cambia el tamaño
       del globo: decide cuánto aire tiene alrededor y dónde cae el fundido de
       abajo. svh y no vh: en iOS vh cuenta la barra del navegador que se
       esconde, y el globo salía cortado por abajo al cargar. */
    --globe-h: clamp(300px, 56svh, 460px);
    /* Centrado: mismo hueco arriba que abajo. max(0px, …) por si alguien abre
       el sitio en una ventana más baja que la propia banda. */
    --globe-top: max(0px, calc((var(--hero-h) - var(--globe-h)) * 0.5));

    /* ── DÓNDE CAE EL DISCO, EN CSS ────────────────────────────────────────
       El titular y la órbita necesitan saber dónde está el globo, y el globo
       lo dibuja WebGL. Preguntárselo al lienzo sería un salto de maquetación
       (el globo arranca diferido: la posición llegaría tarde y movería el
       titular = CLS). Así que se calcula, con las MISMAS cuentas que
       risk-sphere.js:

         diámetro = min(relleno · ancho del lienzo, 0.8692 · alto del lienzo)

       El primer término es el caso normal (el disco ocupa `relleno` del ancho);
       el segundo es el tope BASE_SCALE de la cámara, que manda en bandas muy
       bajas. El 0.8692 sale de 2·R·BASE_SCALE / visibleHW = 4.68 / 5.3848.
       El diámetro sí es exacto: comprobado leyendo el framebuffer a
       360/390/430 px.

       Y de ahí sale --sao-y, la altura del marcador de São Paulo. AQUÍ NO HAY
       NÚMERO EXACTO QUE VALGA, y conviene saberlo antes de tocarlo: el globo
       gira (0.075 rad/s) y se ladea (sin(t·0.2)·0.07), así que São Paulo NO
       está quieto. Muestreado del evento "globe:pins" cada 250 ms durante
       180 s a 390×844, su y de viewport barre de 402.4 a 459.6 px — de 0.136 a
       0.319 diámetros por debajo del centro del disco, con media 0.219.

       El 0.255 de aquí es una constante elegida DENTRO de ese barrido, no una
       medición: preguntarle al lienzo dónde está el marcador movería el
       titular en cuanto el globo arrancara (= CLS), así que se fija. Lo que
       importa es la consecuencia, y esa sí está medida: con los 24 px de aire
       de .hero-gap, el titular arranca entre 4 px (peor instante, marcador
       abajo del todo) y 61 px por debajo del marcador. Nunca lo pisa. Si algún
       día se sube el 0.255, ese margen de 4 px es lo primero que se gasta. */
    --globe-w: 100vw;
    --globe-cx: 50vw;
    --globe-fill: .80;
    --globe-d: min(calc(var(--globe-fill) * var(--globe-w)), calc(.8692 * var(--globe-h)));
    --sao-y: calc(var(--globe-top) + var(--globe-h) * .5 + var(--globe-d) * .255);

    /* Dónde aterriza el globo: el centro del hueco de 26 px del wordmark
       (TopBar.astro), que va al principio del .container de la barra — o sea
       pegado al margen, salvo desde 1200 px, donde el contenedor deja de tocar
       el borde. Estos tres son el valor por defecto: src/scripts/hero.ts los
       vuelve a escribir midiendo el ícono de verdad al arrancar y en cada
       resize, que es lo único exacto (el tamaño del disco depende de si manda
       el ancho del lienzo o el tope de la cámara). */
    --park-x: calc(max(0px, (100vw - var(--container)) / 2) + var(--gutter) + 13px);
    --park-y: calc(var(--topbar-h) / 2);
    --park-s: .083;
    --orbit-x: calc(var(--park-x) - var(--globe-cx));
    --orbit-y: calc(var(--park-y) - var(--globe-top) - var(--globe-h) / 2);

    /* Colores del texto que va SOBRE el globo. Son propios y no los tokens
       generales porque el fondo es el globo, no la página: en oscuro el texto
       va hueso sobre partículas claras, y en claro va tinta sobre un lienzo
       claro (ver .hero-globe). */
    --hero-ink: #F7F7F3;
    --hero-ink-2: #D8D8D2;
    --hero-ink-3: #BFBFB8;
    --hero-halo: 0 1px 2px rgba(0,0,0,.92), 0 4px 22px rgba(0,0,0,.78);
    --hero-halo-2: 0 1px 3px rgba(0,0,0,.95);
    --hero-up: #35D89A;
    --hero-warn: #FFC46B;

    position: relative;
    min-height: var(--hero-h);
    /* Columna flex: el chip de fuente (.hero-source) se empuja con
       margin-top: auto hasta el borde de abajo del hero. */
    display: flex;
    flex-direction: column;
    /* CUÁNTO PUEDE PASARSE EL HERO DE LA PRIMERA PANTALLA. Puede crecer, pero
       no hasta meterse debajo del bottom nav: de los --hero-peek px que asoman,
       los últimos --bottomnav-h están tapados por él. En un teléfono de 844 px
       el contenido se pasa 14 px y no hay nada que hacer; en uno de 667 se
       pasaba 102 y el chip de fuente quedaba ENTERO detrás de la barra de
       abajo. Con el tope puesto, lo que cede es .hero-gap y el titular sube —
       en una pantalla baja acaba por encima de São Paulo, que es justo lo que
       hacía antes, y el chip se ve. Nada de media queries de alto: en iOS la
       barra del navegador cambia el alto del viewport a media página y el hero
       daría un salto; svh no se mueve. */
    max-height: calc(var(--hero-h) + max(0px, var(--hero-peek) - var(--bottomnav-h) - var(--sp-2)));
  }

  /* Modo día: el fondo del globo se aclara (ver .hero-globe) y con él tiene que
     aclararse el texto que va encima, o se queda hueso sobre hueso. */
  :global(:root[data-theme="light"]) .hero {
    --hero-ink: #101216;
    --hero-ink-2: #33363D;
    --hero-ink-3: #4A4E57;
    --hero-halo: 0 1px 2px rgba(255,255,255,.92), 0 4px 22px rgba(255,255,255,.85);
    --hero-halo-2: 0 1px 3px rgba(255,255,255,.95);
    --hero-up: #05734A;
    --hero-warn: #8A5600;
  }

  /* La banda del globo y la del cielo ocupan EXACTAMENTE el mismo sitio: la de
     arriba lleva el lienzo y viaja en la órbita, la de abajo se queda quieta.
     Las dos con el mismo fundido: sin borde duro, se disuelven en la página, y
     el degradado tapa además el canto del lienzo. */
  .hero-globe, .hero-sky {
    position: fixed;
    top: var(--globe-top); left: 0; right: 0;
    height: var(--globe-h);
    -webkit-mask-image: linear-gradient(to bottom, #000 52%, rgba(0,0,0,.55) 78%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 52%, rgba(0,0,0,.55) 78%, transparent 100%);
  }
  .hero-globe { z-index: 1; touch-action: pan-y; will-change: transform, opacity; }
  /* EL CIELO. El lienzo del globo es transparente: este degradado es lo que hay
     detrás de las partículas, y por eso cambia con el tema. En claro no puede
     ser blanco puro — las partículas son casi blancas en el mar y desaparecían;
     con el hueso de --bg-0 y un centro un pelo más claro el disco se separa del
     fondo. */
  .hero-sky {
    z-index: 0; pointer-events: none;
    --globe-sky-1: #17171B;
    --globe-sky-2: #08080A;
    background: radial-gradient(circle at 50% 42%, var(--globe-sky-1), var(--globe-sky-2) 72%);
  }
  :global(:root[data-theme="light"]) .hero-sky {
    --globe-sky-1: #FDFDFB;
    --globe-sky-2: #E7E7E0;
  }
  /* Cuando el globo aterriza, el cielo ya está a cero desde el 22 %: esto es
     para sacarlo también del compositor. */
  .hero-globe.is-parked ~ .hero-sky { visibility: hidden; }

  .hero-globe > * { position: absolute; inset: 0; }
  .globe-host { width: 100%; height: 100%; }
  .globe-host :global(canvas) { width: 100% !important; height: 100% !important; }

  /* El SVG de respaldo ocupa exactamente el mismo hueco que el lienzo, pero
     NACE APAGADO: lo normal es no verlo nunca. Se enciende con .is-still, que
     lo pone hero.ts cuando sabe que no va a haber globo (sin WebGL, o three.js
     que no llega), y con prefers-reduced-motion, ahí desde el primer frame y
     sin JS de por medio (ver más abajo). .is-live —que es el "ya pinta el
     lienzo"— gana a las dos: va después y con más especificidad. */
  .hero-globe-still { display: grid; place-items: center; opacity: 0; transition: opacity .16s ease; }
  /* El SVG mide lo mismo que el disco del lienzo (su círculo llena el viewBox),
     así que si el respaldo entra en juego no cambia de tamaño nada. */
  .hero-globe-still :global(svg) { width: min(var(--globe-d), 100%); height: auto; }
  .hero-globe.is-still .hero-globe-still { opacity: 1; }
  .hero-globe.is-live .hero-globe-still { opacity: 0; }
  /* En claro el SVG es el mismo dibujo del tema oscuro (disco oscuro + puntos
     hueso): invertido pasa a disco claro + puntos de tinta, que es lo que hace
     falta aquí. Solo el filtro — NADA de opacity en esta regla, que empata en
     especificidad con .is-live y le ganaría por ir después: el SVG se quedaría
     puesto para siempre. */
  :global(:root[data-theme="light"]) .hero-globe-still { filter: invert(1) hue-rotate(180deg); }

  .hero-mark { position: absolute; left: 0; width: 1px; height: 1px; pointer-events: none; }
  .hero-mark-top { top: 4px; }
  /* El MISMO número que animation-range (y que el recorrido del respaldo en
     hero.ts): la órbita tiene que terminar exactamente en el frame en que este
     testigo cruza el borde de arriba y el globo se da por aterrizado. Con el
     80 % en porcentaje del hero —que crece si el contenido no cabe— las dos
     cosas se separaban y el aterrizaje daba un salto. */
  .hero-mark-end { top: calc(var(--hero-h) * .8); }

  /* Copy */
  /* El titular ARRANCA justo por debajo del marcador de São Paulo (--sao-y),
     que es la bolsa que queda más abajo a la derecha del globo. Antes colgaba
     del borde de abajo de la banda y su primera línea caía a la altura del
     marcador: el texto se comía toda la mitad de abajo del planeta. Anclado
     por arriba cubre solo el último tercio, y lo que crezca por debajo (la
     barra de bolsas) sigue sin mover el conjunto globo+titular. Los 24 px son
     el aire entre el punto de São Paulo y la primera línea. */
  .hero-gap { flex: 0 1 calc(var(--sao-y) + 24px); min-height: 0; }
  .hero-head { flex: none; display: flex; }
  .hero-copy {
    position: relative;
    z-index: 3;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .hero-title {
    margin: 0;
    max-width: 15ch;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(1.75rem, 8.2vw, 2.5rem);
    line-height: 1.12;
    letter-spacing: -.015em;
    color: var(--hero-ink);
    /* Contraste garantizado sobre un fondo que se mueve: la sombra hace de
       fondo local. Dos capas — una cerrada y opaca que separa el trazo de las
       partículas, y una abierta que apoya el conjunto. Medido sobre el peor
       píxel del globo (partícula de tierra iluminada, ~#C9C6BE): 4.9:1. */
    text-shadow: var(--hero-halo);
  }
  /* La firma va DENTRO del titular, pegada al final de la última palabra y en
     su misma línea: mono de 11 px contra el serif de 32, tenue y sin peso, se
     lee y no compite. Va en la misma caja que el titular, así que el salto de
     línea del titular no cambia; si detrás de la última palabra no cupiera,
     bajaría entera (nowrap) en vez de partirse. */
  .hero-by {
    font-size: 11px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: .04em;
    white-space: nowrap;
    color: var(--hero-ink-3);
    text-shadow: var(--hero-halo-2);
  }
  .today-line { color: var(--hero-ink-2); text-shadow: var(--hero-halo-2); min-height: 1rem; }
  .today-line.skel { color: transparent; }
  .today-line :global(.st-open) { color: var(--hero-up); }
  .today-line :global(.st-closed) { color: var(--hero-warn); }

  /* La barra de bolsas: en el hueco que queda entre la línea de estado y el
     final del hero. z-index 3 y pointer-events propios — el hero-copy de
     encima los tiene apagados, esto no. */
  .hero-world { position: relative; z-index: 3; margin-top: var(--sp-5); }
  /* El chip de fuente: empujado al borde de abajo del hero, con un hueco
     mínimo por si la pantalla es tan baja que no sobra sitio. */
  .hero-source {
    position: relative; z-index: 3;
    margin-top: auto; padding-top: var(--sp-5); padding-bottom: var(--sp-4);
  }
  /* El aviso de "animación en pausa" solo aparece cuando de verdad lo está. */
  .hero-motion { display: none; margin-top: var(--sp-3); }
  @media (prefers-reduced-motion: reduce) { .hero-motion { display: block; } }

  /* Pastillas de cambio del día pegadas a los marcadores. Las coloca
     src/scripts/hero.ts con transform; aquí solo va el aspecto. */
  .hero-pins { pointer-events: none; z-index: 2; overflow: hidden; }
  .hero-pins :global(.pin) {
    position: absolute; top: 0; left: 0;
    display: inline-flex; align-items: center; gap: 5px;
    padding: 3px 8px; border-radius: var(--r-pill);
    background: var(--pin-bg);
    border: 1px solid var(--pin-line);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    font-family: var(--font-mono); font-size: 11px; line-height: 1.35;
    font-variant-numeric: tabular-nums; white-space: nowrap;
    color: var(--pin-ink);
    opacity: 0; transition: opacity .35s ease;
  }
  .hero-pins {
    --pin-bg: rgba(10, 10, 13, .74);
    --pin-line: rgba(244, 244, 241, .16);
    --pin-ink: #EDEDE8;
    --pin-strong: #FFF;
    --pin-up: #35D89A;
    --pin-down: #FF7B7F;
    --pin-flat: #B9B9C2;
  }
  :global(:root[data-theme="light"]) .hero-pins {
    --pin-bg: rgba(255, 255, 255, .82);
    --pin-line: rgba(18, 19, 22, .14);
    --pin-ink: #23262C;
    --pin-strong: #101216;
    --pin-up: #05734A;
    --pin-down: #B8262E;
    --pin-flat: #5B5E66;
  }
  .hero-pins :global(.pin.on) { opacity: 1; }
  .hero-pins :global(.pin b) { font-weight: 500; color: var(--pin-strong); }
  .hero-pins :global(.pin .up) { color: var(--pin-up); }
  .hero-pins :global(.pin .down) { color: var(--pin-down); }
  .hero-pins :global(.pin .flat) { color: var(--pin-flat); }

  /* ── LA ÓRBITA ────────────────────────────────────────────────────────
     Al bajar, el globo NO se va en línea recta hasta el ícono de la barra: se
     aleja como se alejaría en el espacio. Describe un arco —baja y se abre
     hacia la izquierda, y desde ahí sube hasta el logo— mientras se encoge, se
     ladea sobre su eje y se difumina.

     LA CURVA es una Bézier cuadrática con P0 en el centro de la banda, P2 en
     el hueco del wordmark y el punto de control colgado ABAJO a la izquierda:

       P1 = P0 + (0.75·Tx, −0.55·Ty)   con T = P2 − P0 (Tx y Ty negativos)

     que desarrollada da, para la traslación en cada eje:

       x(t) = Tx · (1.5·t·(1−t) + t²)
       y(t) = Ty · (−1.1·t·(1−t) + t²)

     y(t) sale POSITIVA hasta t ≈ 0.52 aunque Ty sea negativa: eso es el globo
     bajando (hasta ~48 px a 390 px de ancho) antes de subir. Los @keyframes son
     esa curva muestreada cada 12.5 %; entre muestra y muestra el navegador
     interpola recto y no se nota. Las mismas cuentas, esta vez cerradas, están
     en src/scripts/hero.ts para donde no hay scroll-timeline.

     LA PROFUNDIDAD son tres cosas a la vez, todas de compositor: la escala cae
     con t^0.75 (más deprisa al principio, como algo que se aleja de verdad),
     la opacidad aguanta hasta el 50 % y se va al final, y el propio globo
     —.globe-host, no la banda: rotar la banda ladearía también el rectángulo
     del cielo— gira 20° y coge 1.4 px de desenfoque en el último tercio.

     Y TERMINA ENCAJADO: en el 100 % el centro de la banda está exactamente en
     (--park-x, --park-y), que es el centro del hueco de 26 px del wordmark, y
     el disco mide --globe-d · --park-s ≈ 26 px. El testigo .hero-mark-end está
     en el mismo punto del scroll, así que el globo se apaga justo cuando el
     ícono se enciende (ese lado vive en TopBar.astro). */
  @keyframes hero-park {
    0%    { transform: translate3d(0, 0, 0) scale(1); opacity: 1; }
    12.5% { transform: translate3d(calc(var(--orbit-x) * .1797), calc(var(--orbit-y) * -.1047), 0) scale(calc(1 + (var(--park-s) - 1) * .2102)); opacity: 1; }
    25%   { transform: translate3d(calc(var(--orbit-x) * .3438), calc(var(--orbit-y) * -.1438), 0) scale(calc(1 + (var(--park-s) - 1) * .3536)); opacity: 1; }
    37.5% { transform: translate3d(calc(var(--orbit-x) * .4922), calc(var(--orbit-y) * -.1172), 0) scale(calc(1 + (var(--park-s) - 1) * .4792)); opacity: 1; }
    50%   { transform: translate3d(calc(var(--orbit-x) * .625),  calc(var(--orbit-y) * -.025),  0) scale(calc(1 + (var(--park-s) - 1) * .5946)); opacity: 1; }
    62.5% { transform: translate3d(calc(var(--orbit-x) * .7422), calc(var(--orbit-y) * .1328),  0) scale(calc(1 + (var(--park-s) - 1) * .7031)); opacity: .97; }
    75%   { transform: translate3d(calc(var(--orbit-x) * .8438), calc(var(--orbit-y) * .3563),  0) scale(calc(1 + (var(--park-s) - 1) * .8059)); opacity: .9; }
    87.5% { transform: translate3d(calc(var(--orbit-x) * .9297), calc(var(--orbit-y) * .6453),  0) scale(calc(1 + (var(--park-s) - 1) * .9047)); opacity: .55; }
    100%  { transform: translate3d(var(--orbit-x), var(--orbit-y), 0) scale(var(--park-s)); opacity: 0; }
  }
  /* El giro sobre su eje y el desenfoque van en el lienzo, no en la banda.
     Los números son las MISMAS funciones de hero.ts evaluadas en cada muestra
     —giro = −20·t^1.25, desenfoque = 1.4·(t−0.625)/0.375— redondeadas a dos
     decimales, no valores a ojo: así las dos rutas no se separan. */
  @keyframes hero-park-spin {
    0%    { transform: rotate(0deg); filter: none; }
    25%   { transform: rotate(-3.54deg); }
    50%   { transform: rotate(-8.41deg); }
    62.5% { filter: blur(0px); }
    75%   { transform: rotate(-13.96deg); filter: blur(.47px); }
    87.5% { transform: rotate(-16.93deg); filter: blur(.93px); }
    100%  { transform: rotate(-20deg); filter: blur(1.4px); }
  }
  /* Las pastillas se van en cuanto arranca la órbita: van pegadas a un
     marcador que a partir de aquí gira, y una etiqueta despegada de su punto
     canta más que no tenerla. */
  @keyframes hero-park-pins {
    0%   { opacity: 1; }
    15%  { opacity: 0; }
    100% { opacity: 0; }
  }
  /* El cielo se queda en el hero: lo que se va de viaje es la esfera. */
  @keyframes hero-park-sky {
    0%   { opacity: 1; }
    22%  { opacity: 0; }
    100% { opacity: 0; }
  }
  @supports (animation-timeline: scroll()) {
    .hero-globe, .hero-globe .globe-host, .hero-globe .hero-pins, .hero-sky {
      animation: hero-park linear both;
      animation-timeline: scroll(root block);
      animation-range: 0 calc(var(--hero-h) * .8);
    }
    .hero-globe .globe-host { animation-name: hero-park-spin; }
    .hero-globe .hero-pins { animation-name: hero-park-pins; }
    .hero-sky { animation-name: hero-park-sky; }
  }
  /* Aterrizado: fuera de la pantalla y fuera del compositor. El bucle de
     WebGL se para por evento (ver hero.ts); esto es la parte visual. */
  .hero-globe.is-parked { visibility: hidden; }

  /* ── Menos movimiento ──────────────────────────────────────────────────
     Sin transición de scroll y sin globo fijo: se queda dentro del hero, ya
     orientado a América, y se va con la página como cualquier imagen. Tampoco
     hay entrada de partículas: risk-sphere.js pinta la esfera ya formada. Y
     como no va a haber animación ninguna, aquí sí se ve el SVG de respaldo
     desde el primer frame, hasta que el lienzo tenga su fotograma quieto. */
  @media (prefers-reduced-motion: reduce) {
    /* Nada de órbita: ni arco, ni giro, ni desenfoque. El globo se queda dentro
       del hero y se va con la página; cuando el hero termina, se apaga con una
       transición corta en vez de desaparecer de golpe. */
    /* La visibility se retrasa lo que dura el fundido: si no, el navegador la
       aplica en el mismo frame y no se ve transición ninguna. */
    .hero-globe {
      position: absolute; will-change: auto;
      transition: opacity .18s linear, visibility 0s linear .18s;
      /* base.css deja TODAS las transiciones en .01ms cuando se pide menos
         movimiento, y con razón: ahí no puede haber nada que se desplace. Un
         fundido de 180 ms no se desplaza —solo baja la opacidad— y es lo que
         hace falta para que el globo no desaparezca de golpe. Por eso, y solo
         para el globo, se recupera la duración. */
      transition-duration: .18s, 0s !important;
    }
    .hero-globe, .hero-globe .globe-host, .hero-globe .hero-pins, .hero-sky { animation: none; }
    .hero-globe .globe-host { transform: none; filter: none; }
    .hero-sky { position: absolute; opacity: 1; }
    .hero-globe.is-parked { opacity: 0; }
    .hero-globe-still { opacity: 1; transition: none; }
    .hero-pins :global(.pin) { transition: none; }
  }

  /* ── Escritorio ────────────────────────────────────────────────────────
     El mismo hero, ensanchado: el globo sigue a sangre y el titular baja a la
     izquierda dentro del contenedor. Nada de un diseño distinto. */
  @media (min-width: 768px) {
    .hero {
      --hero-peek: 150px;
      --globe-h: clamp(400px, 64svh, 700px);
      /* En pantallas anchas el disco vuelve al 85 %: ahí sobra aire a los
         lados y no hace falta quitárselo al globo. Este 768 es EL corte, el
         único: `relleno()` en risk-sphere.js lee esta misma variable, así que
         no hay un segundo número que se pueda quedar atrás. Y como el disco es
         mucho mayor, la escala de aterrizaje tiene que ser mucho menor para
         caber en los mismos 26 px. */
      --globe-fill: .85;
      --park-s: .046;
    }
    .hero-title { max-width: 18ch; font-size: clamp(2.5rem, 4.6vw, 3.75rem); }
    .hero-by { font-size: 12px; }
  }
  @media (min-width: 1100px) {
    /* En pantallas anchas el globo se corre a la derecha para dejar el titular
       sobre fondo limpio: mismo hero, dos tercios de aire. Ojo: al moverse el
       lienzo se mueve también su centro, y con él el origen de la órbita y la
       vertical de São Paulo. */
    .hero-globe, .hero-sky { left: 22%; }
    .hero { --globe-w: 78vw; --globe-cx: 61vw; }
    .hero-title { max-width: 16ch; }
  }
</style>

<script src="../../scripts/hero.ts"></script>
