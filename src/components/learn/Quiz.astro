---
// Quiz de comprensión al final de cada lección: tres preguntas escritas en el
// frontmatter del MDX (`quiz: [{ q, options, answer, why }]`, schema en
// src/content.config.ts) y pintadas aquí.
//
// Sin backend y sin cuenta: se contesta en el navegador, se marca correcto o
// incorrecto, se explica POR QUÉ (esa línea es el punto del ejercicio) y el
// resultado se guarda en localStorage junto al progreso de lecturas
// (src/scripts/lessons-progress.ts). La lógica está en src/scripts/quiz.ts.
//
// Accesibilidad: radio buttons de verdad dentro de un <fieldset> con <legend>,
// así que las flechas del teclado y los lectores de pantalla funcionan solos;
// la explicación de cada pregunta y el marcador viven en regiones aria-live,
// y el foco se ve porque el anillo lo pinta el <label>, no el input tapado.
import type { Locale } from '../../i18n/routes';
import { useT } from '../../i18n/ui';

interface QuizItem { q: string; options: string[]; answer: number; why: string }
interface Props { locale: Locale; slug: string; quiz: QuizItem[] }
const { locale, slug, quiz } = Astro.props;
const t = useT(locale);
---
<section class="quiz" data-quiz={slug} aria-labelledby="quiz-h"
  data-right={t('quiz.right')} data-wrong={t('quiz.wrong')}
  data-tpl-pending={t('quiz.pending')} data-tpl-progress={t('quiz.progress_tpl')}
  data-tpl-score={t('quiz.score_tpl')} data-perfect={t('quiz.perfect')}>
  <div class="quiz-head">
    <p class="eyebrow">{t('quiz.eyebrow')}</p>
    <h2 id="quiz-h" class="t-h3">{t('quiz.title')}</h2>
    <p class="t-small muted">{t('quiz.intro')}</p>
  </div>

  <ol class="quiz-list">
    {quiz.map((item, i) => (
      <li class="quiz-q" data-quiz-q={i} data-answer={item.answer}>
        <fieldset class="quiz-fieldset">
          <legend class="quiz-legend"><span class="quiz-n num" aria-hidden="true">{i + 1}</span>{item.q}</legend>
          <div class="quiz-opts">
            {item.options.map((opt, j) => (
              <label class="quiz-opt">
                <input type="radio" name={'quiz-' + slug + '-' + i} value={j} data-quiz-opt={j}>
                <span class="quiz-opt-text">{opt}</span>
                <span class="quiz-mark" aria-hidden="true"></span>
              </label>
            ))}
          </div>
        </fieldset>
        <p class="quiz-why" data-quiz-why hidden>
          <span class="quiz-verdict" data-quiz-verdict></span>
          <span class="quiz-reason">{item.why}</span>
        </p>
      </li>
    ))}
  </ol>

  <div class="quiz-foot">
    <p class="quiz-score t-small" data-quiz-score role="status" aria-live="polite">{t('quiz.pending')}</p>
    <button type="button" class="btn btn-ghost btn-sm quiz-reset" data-quiz-reset hidden>{t('quiz.reset')}</button>
  </div>
</section>
<script src="../../scripts/quiz.ts"></script>

<style>
  .quiz { margin-top: var(--sp-8); padding-top: var(--sp-5); border-top: 1px solid var(--line); }
  .quiz-head { display: flex; flex-direction: column; gap: 4px; }
  .quiz-head .t-small { max-width: var(--measure); margin-top: 2px; }
  .quiz-list { list-style: none; display: flex; flex-direction: column; gap: var(--sp-3); margin-top: var(--sp-4); padding: 0; }
  .quiz-q { background: var(--bg-1); border: 1px solid var(--line); border-radius: var(--r-card); padding: var(--card-pad); box-shadow: var(--shadow-1); }
  .quiz-fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  .quiz-legend { padding: 0; font-size: var(--fs-body); line-height: var(--lh-body); font-weight: 500; color: var(--ink); display: flex; gap: 10px; }
  .quiz-n { flex: none; width: 22px; height: 22px; border-radius: 50%; background: var(--bg-2); color: var(--ink-2); font-size: var(--fs-caption); display: inline-flex; align-items: center; justify-content: center; margin-top: 1px; }
  .quiz-opts { display: flex; flex-direction: column; gap: 8px; margin-top: var(--sp-3); }

  /* El input real se queda (teclado y lector de pantalla lo usan) pero se
     dibuja el círculo con .quiz-mark, y el anillo de foco lo pinta el label. */
  .quiz-opt { position: relative; display: grid; grid-template-columns: auto 1fr; align-items: start; gap: 10px; min-height: 44px; padding: 10px 12px; border: 1px solid var(--line); border-radius: var(--r-btn); background: var(--bg-0); cursor: pointer; font-size: var(--fs-small); line-height: var(--lh-small); color: var(--ink); }
  .quiz-opt:hover { border-color: var(--ink-3); }
  .quiz-opt input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; }
  .quiz-mark { grid-column: 1; grid-row: 1; width: 18px; height: 18px; margin-top: 1px; border: 2px solid var(--ink-3); border-radius: 50%; background: transparent; flex: none; }
  .quiz-opt-text { grid-column: 2; grid-row: 1; }
  /* El punto verde de "elegida" solo vale ANTES de calificar: sin el :not(),
     :has() gana en especificidad y la respuesta equivocada salía con relleno
     verde y una ✕ roja encima. */
  .quiz-opt:not(.is-right):not(.is-wrong):has(input:checked) .quiz-mark { border-color: var(--brand-text); box-shadow: inset 0 0 0 4px var(--brand-fill); }
  .quiz-opt:has(input:focus-visible) { box-shadow: var(--focus-ring); }

  /* Resultado: color + símbolo, nunca solo color. */
  .quiz-opt.is-right { border-color: var(--up); background: var(--brand-wash); }
  .quiz-opt.is-wrong { border-color: var(--down); }
  .quiz-opt.is-right .quiz-mark, .quiz-opt.is-wrong .quiz-mark { border: 0; box-shadow: none; display: inline-flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; line-height: 1; }
  .quiz-opt.is-right .quiz-mark::before { content: '✓'; color: var(--up-text); }
  .quiz-opt.is-wrong .quiz-mark::before { content: '✕'; color: var(--down-text); }

  .quiz-why { margin-top: var(--sp-3); padding-top: var(--sp-3); border-top: 1px solid var(--line); font-size: var(--fs-small); line-height: var(--lh-small); color: var(--ink-2); }
  .quiz-verdict { font-weight: 600; color: var(--ink); margin-right: 6px; }
  .quiz-why.is-right .quiz-verdict { color: var(--up-text); }
  .quiz-why.is-wrong .quiz-verdict { color: var(--down-text); }
  .quiz-foot { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3); flex-wrap: wrap; margin-top: var(--sp-4); }
  .quiz-score { color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .quiz-score.is-done { color: var(--ink); font-weight: 500; }
</style>
