---
// /methodology y /es/metodologia (sección D del plan): qué datos usamos y de
// quién, cadencia y retraso por superficie, cadena de respaldo y caché, qué
// hace la IA y qué no, política de correcciones con changelog, conflictos de
// interés, "esto no es asesoría" y contacto para errores. Las cadencias salen
// de los propios endpoints de /api (caché en memoria + CDN) y de src/data.
import type { Locale } from '../../i18n/routes';
import { route } from '../../i18n/routes';
import { RATES } from '../../data/home';
const { locale } = Astro.props as { locale: Locale };
const L = (id: string) => route(id, locale);
const GITHUB = 'https://github.com/Jaime-pixel817/smart-finance';
const ISSUES = GITHUB + '/issues';
const LINKEDIN = 'https://www.linkedin.com/in/jaime-sandoval-ricano-23b3a4401';

type Row = { surface: string; source: string; cadence: string; delay: string };
type Paso = { n: string; texto: string };
const copy = {
  en: {
    eyebrow: 'Methodology',
    title: 'How Smart Finance is made',
    lede: 'Where every number comes from, how fresh it is, what the AI does and does not do, and how mistakes get fixed. This page changes whenever the site does.',
    updated: 'Last updated 21 Aug 2026',
    dataH: 'Data: what we use and from whom',
    dataIntro: 'Every surface shows a source chip with the provider, the delay and the time of the last refresh. These are the real cadences, taken from the code that serves the data (the /api folder of the public repository).',
    cols: ['Surface', 'Source', 'Refresh', 'Delay / notes'],
    rows: [
      { surface: 'Stocks and index ETFs (SPY, QQQ, DIA, AAPL, MSFT, NVDA, AMZN) on the home pulse, /market and asset cards', source: 'Twelve Data, one batched request (Yahoo Finance as backup)', cadence: 'Every 15 minutes (server and CDN cache)', delay: 'Prices delayed at least 15 minutes; change is against the previous close' },
      { surface: 'Crypto (BTC, ETH, XRP, SOL)', source: 'CoinGecko', cadence: 'Every 15 minutes', delay: 'Change is the last 24 hours; price in US dollars' },
      { surface: 'Currencies (USD/MXN, EUR/MXN, CHF/MXN, EUR/USD, GBP/USD, USD/JPY) and the VIX', source: 'Yahoo Finance', cadence: 'Every 15 minutes', delay: 'Delayed at least 15 minutes' },
      { surface: 'Price charts 1D to 5Y and sparklines', source: 'Yahoo Finance', cadence: 'Charts cached 60 seconds; sparklines 15 minutes', delay: '1D is ONE session in 5-minute bars, cut by the exchange’s own day, so on a weekend you see the last trading day whole. The chart says which session it is showing' },
      { surface: 'Reference rates (Banxico target rate, Fed funds range)', source: 'Banco de México and Federal Reserve announcements, entered by hand', cadence: 'After each decision; verification date shown (currently ' + RATES.verificado + ')', delay: 'Hidden automatically if the verification is older than ' + RATES.maxDias + ' days' },
      { surface: 'News, explained (/news) and today’s story on the home', source: 'Bloomberg Markets RSS feed; the explanation is drafted with Claude and reviewed by me', cadence: 'Drafts once a day at 5:30 CDMX (11:30 UTC), up to three; published when I approve them', delay: 'Nothing appears on the site until a person approves it. Every story links to the original and shows its time' },
      { surface: 'Market open / closed labels', source: 'Computed from NYSE (9:30–16:00 ET) and BMV (8:30–15:00 CDMX) regular hours', cadence: 'On every page load', delay: 'Monday to Friday, holidays not included: a guide, not a promise' },
      { surface: 'Weekly newsletter', source: 'The same data as the site plus the story I approved that week; sent with Resend', cadence: 'Sundays at 8:00 CDMX (14:00 UTC)', delay: 'Double opt-in; unsubscribe link in every email. It was daily until August 2026 — the free Resend plan allows 100 emails a day, shared with the sign-up confirmations, so a daily send left almost no room for new subscribers' }
    ] as Row[],
    fallbackH: 'Fallback chain and cache',
    fallback: [
      'The cache is SHARED, in Redis, and no longer one copy per server instance. That distinction is the whole point: the site runs on serverless functions, and every cold start used to begin with an empty cache and ask the provider again, so the same data was paid for many times over on a busy day.',
      'Every cached value is kept twice: the fresh copy for its normal window (15 minutes, or 60 seconds for charts) and a second copy for 48 hours. When a provider fails, that second copy is what you see, marked as the last known value instead of a gap.',
      'When a window expires, only ONE instance calls the provider (a 20-second lock in Redis) while the rest wait or serve the last copy. Otherwise every expiry would be a burst of identical requests.',
      'If there is no previous copy, the page says “unavailable, retrying” instead of showing a made-up number.',
      'Stocks fall back from Twelve Data to Yahoo Finance. Currencies, the VIX and the charts have no second provider yet; that is a known gap.',
      'Twelve Data’s free quota (800 credits a day) is counted per provider per day. Past 700 credits the site stops calling it until midnight UTC and serves stocks from Yahoo Finance instead — automatically, without anyone watching.'
    ],
    aiH: 'What the AI does, and what it does not',
    aiDoes: 'Claude (claude-haiku-4-5) writes the FIRST DRAFT of each news explainer from a real Bloomberg headline and its summary: what happened, why it matters, which assets it touches and which lesson helps. Those drafts are labeled “AI summary · reviewed by Jaime” and are never published on their own. I also use Claude as an assistant to draft and edit code and text; the repository is public.',
    aiDoesNot: 'No figure on this site comes from an AI without a source. The lessons are written by me and list their sources with the date they were checked. Research reports, when they come, will be written by me with Claude as an assistant for data handling and drafting, and every number will link to a filing or a dataset. The AI never recommends anything, and neither do I.',
    revH: 'How a news story gets published',
    revIntro: 'This is the part that matters: an AI writes the draft, a person decides. The whole chain is in the public repository (api/news.js and api/_lib/).',
    revSteps: [
      { n: '1', texto: 'Once a day, a scheduled job reads the Bloomberg Markets RSS feed and asks Claude for up to three drafts, using only what the headline and the feed summary say. Never more than three: that is also the cost ceiling, around one US cent a day.' },
      { n: '2', texto: 'Each draft is stored as “borrador” (draft). Drafts are not public: asking the public endpoint for them returns an error on purpose.' },
      { n: '3', texto: 'I read them, next to the original link. I approve, edit before approving, or reject. If a draft is missing a piece the site needs, approving it fails and says what is missing.' },
      { n: '4', texto: 'Only what I approve is served to the site, so it appears within a minute. If I rewrote the text, the label changes from “AI summary · reviewed by Jaime” to “Written by Jaime”.' },
      { n: '5', texto: 'Approved stories are then copied into the repository, so each one gets its own permanent page at the next deploy. The URL is the same before and after.' }
    ] as Paso[],
    corrH: 'Corrections',
    corrIntro: 'If something is wrong, it gets fixed and logged here, with the date.',
    changelog: [
      ['2026-08-23', 'Charts: 1D is now one whole session, cut by the exchange’s own day, so it is never empty when the market is closed; a line above the chart says which session you are looking at; you can drag your finger across it at any time to read the hour, the price and how much it had moved; and the period’s high and low are marked.'],
      ['2026-08-23', 'Four new lessons (your first credit card, what a share is, how an exchange works, ETFs), an interactive risk-and-return module and a three-question quiz at the end of all ten lessons.'],
      ['2026-08-22', 'News, explained published at /news: drafts written by Claude from Bloomberg headlines, reviewed one by one by me before anything goes up, each story linking to its source.'],
      ['2026-08-21', 'Lessons moved to the new design with two or more verified sources each, learning paths and local progress; glossary with examples in pesos; /about and /methodology published.'],
      ['2026-08-21', 'Markets: one card per asset with a touch chart, source chip and “what is it”; sitemap generated from the route registry.'],
      ['2026-07-31', 'Lessons: last edit of the legacy versions; reading-time and metadata fixes.'],
      ['2026-07-26', 'Six lessons published in English and Spanish.']
    ],
    coiH: 'Conflicts of interest',
    coi: 'Smart Finance has no sponsors, ads, affiliate links or paid placements. I am a student and I do not manage anyone’s money. If I ever hold a position in an asset I write about, the piece itself will say so. Any portfolio or challenge published here will state whether the money is real or simulated.',
    adviceH: 'This is not advice',
    advice: 'Everything on Smart Finance is educational. It is not financial, investment or tax advice, and it is not a recommendation to buy or sell anything. Market data is delayed and comes from third parties; verify at the source before deciding anything. Your situation is yours; if you need advice, talk to a licensed professional.',
    errH: 'Found an error?',
    err: 'Open an issue on GitHub or send me a message on LinkedIn. Say which page and which number; I will fix it and add it to the changelog.',
    errIssues: 'Report on GitHub', errLinkedin: 'Message on LinkedIn',
    attribH: 'Attribution',
    attrib: 'Charts by TradingView Lightweight Charts (Apache 2.0). Data: Yahoo Finance, CoinGecko, Twelve Data, Bloomberg, Banco de México, Federal Reserve. Fonts: Geist (Vercel) and Fraunces (Undercase Type), both under the SIL Open Font License.',
    about: 'About Jaime', glossary: 'Glossary'
  },
  es: {
    eyebrow: 'Metodología',
    title: 'Cómo se hace Smart Finance',
    lede: 'De dónde sale cada número, qué tan fresco está, qué hace y qué no hace la IA, y cómo se corrigen los errores. Esta página cambia cada vez que cambia el sitio.',
    updated: 'Última actualización: 21 ago 2026',
    dataH: 'Datos: qué usamos y de quién',
    dataIntro: 'Cada superficie muestra un chip de fuente con el proveedor, el retraso y la hora de la última actualización. Estas son las cadencias reales, tomadas del código que sirve los datos (la carpeta /api del repositorio público).',
    cols: ['Superficie', 'Fuente', 'Actualización', 'Retraso / notas'],
    rows: [
      { surface: 'Acciones y ETF de índices (SPY, QQQ, DIA, AAPL, MSFT, NVDA, AMZN) en el pulso del home, /mercado y las fichas', source: 'Twelve Data, una sola petición en lote (Yahoo Finance como respaldo)', cadence: 'Cada 15 minutos (caché en servidor y CDN)', delay: 'Precios con al menos 15 minutos de retraso; el cambio es contra el cierre anterior' },
      { surface: 'Cripto (BTC, ETH, XRP, SOL)', source: 'CoinGecko', cadence: 'Cada 15 minutos', delay: 'El cambio son las últimas 24 horas; precio en dólares' },
      { surface: 'Divisas (USD/MXN, EUR/MXN, CHF/MXN, EUR/USD, GBP/USD, USD/JPY) y el VIX', source: 'Yahoo Finance', cadence: 'Cada 15 minutos', delay: 'Al menos 15 minutos de retraso' },
      { surface: 'Gráficas de 1D a 5A y sparklines', source: 'Yahoo Finance', cadence: 'Gráficas con caché de 60 segundos; sparklines de 15 minutos', delay: '1D es UNA sesión en barras de 5 minutos, cortada por el día de la propia bolsa, así que en fin de semana ves entero el último día hábil. La gráfica dice qué sesión está enseñando' },
      { surface: 'Tasas de referencia (tasa objetivo de Banxico, rango de la Fed)', source: 'Anuncios del Banco de México y de la Reserva Federal, capturados a mano', cadence: 'Tras cada decisión; se muestra la fecha de verificación (hoy ' + RATES.verificado + ')', delay: 'Se ocultan solas si la verificación tiene más de ' + RATES.maxDias + ' días' },
      { surface: 'Noticias explicadas (/es/noticias) y la historia de hoy en el inicio', source: 'RSS de Bloomberg Markets; la explicación la redacta Claude y la reviso yo', cadence: 'Borradores una vez al día a las 5:30 CDMX (11:30 UTC), hasta tres; se publican cuando los apruebo', delay: 'Nada aparece en el sitio hasta que una persona lo aprueba. Cada noticia enlaza al original y muestra su hora' },
      { surface: 'Etiquetas de mercado abierto / cerrado', source: 'Calculadas con el horario regular de NYSE (9:30–16:00 ET) y BMV (8:30–15:00 CDMX)', cadence: 'En cada carga de página', delay: 'Lunes a viernes, sin feriados: una orientación, no una promesa' },
      { surface: 'Boletín semanal', source: 'Los mismos datos del sitio más la noticia que aprobé esa semana; se envía con Resend', cadence: 'Domingos a las 8:00 CDMX (14:00 UTC)', delay: 'Doble confirmación; enlace para darse de baja en cada correo. Fue diario hasta agosto de 2026: el plan gratuito de Resend da 100 correos al día, los mismos que usan las confirmaciones de alta, así que un envío diario casi no dejaba sitio para quien se quisiera suscribir' }
    ] as Row[],
    fallbackH: 'Cadena de respaldo y caché',
    fallback: [
      'La caché es COMPARTIDA, en Redis, y ya no una copia por instancia del servidor. La diferencia es todo el asunto: el sitio corre en funciones serverless, y cada arranque en frío empezaba con la caché vacía y volvía a pedirle al proveedor, así que un día con tráfico pagaba el mismo dato muchas veces.',
      'De cada dato se guardan DOS copias: la fresca durante su ventana normal (15 minutos, o 60 segundos en las gráficas) y otra que dura 48 horas. Cuando el proveedor falla, esa segunda copia es lo que ves, marcada como último dato conocido en vez de un hueco.',
      'Al caducar una ventana, solo UNA instancia le pide al proveedor (un candado de 20 segundos en Redis) mientras las demás esperan o sirven la copia anterior. Si no, cada caducidad sería una ráfaga de peticiones idénticas.',
      'Si no hay copia previa, la página dice “no disponible, se reintenta” en vez de enseñar un número inventado.',
      'Las acciones pasan de Twelve Data a Yahoo Finance como respaldo. Divisas, VIX y gráficas todavía no tienen segundo proveedor; es un hueco conocido.',
      'La cuota gratuita de Twelve Data (800 créditos al día) se cuenta por proveedor y por día. Pasando los 700 créditos el sitio deja de llamarlo hasta la medianoche UTC y sirve las acciones desde Yahoo Finance — solo, sin que nadie esté mirando.'
    ],
    aiH: 'Qué hace la IA y qué no',
    aiDoes: 'Claude (claude-haiku-4-5) escribe el PRIMER BORRADOR de cada noticia explicada a partir de un titular real de Bloomberg y su resumen: qué pasó, por qué importa, qué activos toca y qué lección ayuda a entenderla. Esos borradores van etiquetados como “Resumen IA · revisado por Jaime” y nunca se publican solos. También uso Claude como asistente para redactar y editar código y texto; el repositorio es público.',
    aiDoesNot: 'Ninguna cifra de este sitio sale de una IA sin fuente. Las lecciones las escribo yo y listan sus fuentes con la fecha en que las revisé. Los reportes de research, cuando lleguen, los escribiré yo con Claude como asistente para manejar datos y redactar, y cada número enlazará a un reporte oficial o a un conjunto de datos. La IA nunca recomienda nada, y yo tampoco.',
    revH: 'Cómo se publica una noticia',
    revIntro: 'Esta es la parte que importa: la IA escribe el borrador, una persona decide. Toda la cadena está en el repositorio público (api/news.js y api/_lib/).',
    revSteps: [
      { n: '1', texto: 'Una vez al día, una tarea programada lee el RSS de Bloomberg Markets y le pide a Claude hasta tres borradores, usando solo lo que dicen el titular y el resumen del feed. Nunca más de tres: ese es también el tope de gasto, alrededor de un centavo de dólar al día.' },
      { n: '2', texto: 'Cada borrador se guarda como “borrador”. Los borradores no son públicos: pedirlos por la vía pública devuelve un error a propósito.' },
      { n: '3', texto: 'Los leo, con el enlace al original al lado. Apruebo, edito antes de aprobar, o rechazo. Si a un borrador le falta algo que la página necesita, aprobarlo falla y dice qué falta.' },
      { n: '4', texto: 'Solo lo que apruebo se sirve al sitio, y aparece en menos de un minuto. Si reescribí el texto, la etiqueta cambia de “Resumen IA · revisado por Jaime” a “Escrito por Jaime”.' },
      { n: '5', texto: 'Después, las aprobadas se copian al repositorio, para que cada una tenga su página permanente en el siguiente despliegue. La dirección es la misma antes y después.' }
    ] as Paso[],
    corrH: 'Correcciones',
    corrIntro: 'Si algo está mal, se corrige y se registra aquí, con fecha.',
    changelog: [
      ['2026-08-23', 'Gráficas: el 1D es ahora una sesión entera, cortada por el día de la propia bolsa, así que nunca sale vacío con el mercado cerrado; una línea encima dice qué sesión estás viendo; se puede recorrer con el dedo en cualquier momento para leer la hora, el precio y cuánto había subido o bajado; y quedan marcados el máximo y el mínimo del periodo.'],
      ['2026-08-23', 'Cuatro lecciones nuevas (tu primera tarjeta de crédito, qué es una acción, cómo funciona la bolsa y los ETFs), un módulo interactivo de riesgo y retorno, y un quiz de tres preguntas al final de las diez lecciones.'],
      ['2026-08-22', 'Noticias explicadas en /es/noticias: los borradores los escribe Claude a partir de titulares de Bloomberg y los reviso uno por uno antes de que salga nada, con enlace a la fuente en cada nota.'],
      ['2026-08-21', 'Las lecciones pasan al diseño nuevo con dos o más fuentes verificadas cada una, rutas de aprendizaje y progreso local; glosario con ejemplos en pesos; se publican /acerca y /metodologia.'],
      ['2026-08-21', 'Mercados: una ficha por activo con gráfica táctil, chip de fuente y “qué es”; sitemap generado desde el registro de rutas.'],
      ['2026-07-31', 'Lecciones: última edición de las versiones anteriores; ajustes de tiempo de lectura y metadatos.'],
      ['2026-07-26', 'Se publican seis lecciones en español e inglés.']
    ],
    coiH: 'Conflictos de interés',
    coi: 'Smart Finance no tiene patrocinadores, anuncios, enlaces de afiliado ni menciones pagadas. Soy estudiante y no manejo el dinero de nadie. Si algún día tengo una posición en un activo del que escribo, la propia pieza lo dirá. Cualquier portafolio o reto que se publique aquí dirá si el dinero es real o simulado.',
    adviceH: 'Esto no es asesoría',
    advice: 'Todo en Smart Finance es educativo. No es asesoría financiera, de inversión ni fiscal, y no es una recomendación de comprar o vender nada. Los datos de mercado llegan con retraso y vienen de terceros; verifícalos en la fuente antes de decidir cualquier cosa. Tu situación es tuya; si necesitas asesoría, habla con un profesional con licencia.',
    errH: '¿Encontraste un error?',
    err: 'Abre un issue en GitHub o mándame un mensaje en LinkedIn. Di qué página y qué número; lo corrijo y lo agrego al registro de cambios.',
    errIssues: 'Reportar en GitHub', errLinkedin: 'Mensaje en LinkedIn',
    attribH: 'Atribuciones',
    attrib: 'Gráficas con TradingView Lightweight Charts (Apache 2.0). Datos: Yahoo Finance, CoinGecko, Twelve Data, Bloomberg, Banco de México, Reserva Federal. Tipografías: Geist (Vercel) y Fraunces (Undercase Type), ambas bajo la SIL Open Font License.',
    about: 'Acerca de Jaime', glossary: 'Glosario'
  }
}[locale];
---
<article class="meth">
  <div class="container meth-wrap">
    <header class="meth-head">
      <p class="eyebrow">{copy.eyebrow} <span aria-hidden="true">·</span> {copy.updated}</p>
      <h1 class="t-display">{copy.title}</h1>
      <p class="meth-lede">{copy.lede}</p>
      <nav class="meth-toc rail" aria-label={locale === 'es' ? 'Secciones' : 'Sections'}>
        <a class="chip" href="#data">{copy.dataH}</a>
        <a class="chip" href="#fallback">{copy.fallbackH}</a>
        <a class="chip" href="#ai">{copy.aiH}</a>
        <a class="chip" href="#review">{copy.revH}</a>
        <a class="chip" href="#corrections">{copy.corrH}</a>
        <a class="chip" href="#coi">{copy.coiH}</a>
        <a class="chip" href="#advice">{copy.adviceH}</a>
        <a class="chip" href="#errors">{copy.errH}</a>
      </nav>
    </header>

    <section id="data" class="meth-sec" aria-labelledby="data-h">
      <h2 id="data-h" class="t-h2">{copy.dataH}</h2>
      <p class="muted">{copy.dataIntro}</p>
      <div class="meth-table-wrap">
        <table class="meth-table">
          <thead><tr>{copy.cols.map((c) => <th scope="col">{c}</th>)}</tr></thead>
          <tbody>
            {copy.rows.map((r) => (
              <tr>
                <th scope="row" data-label={copy.cols[0]}>{r.surface}</th>
                <td data-label={copy.cols[1]}>{r.source}</td>
                <td data-label={copy.cols[2]}>{r.cadence}</td>
                <td data-label={copy.cols[3]}>{r.delay}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="fallback" class="meth-sec" aria-labelledby="fb-h">
      <h2 id="fb-h" class="t-h2">{copy.fallbackH}</h2>
      <ul class="meth-list">{copy.fallback.map((f) => <li>{f}</li>)}</ul>
    </section>

    <section id="ai" class="meth-sec" aria-labelledby="ai-h">
      <h2 id="ai-h" class="t-h2">{copy.aiH}</h2>
      <div class="meth-two">
        <div class="card"><p class="eyebrow">{locale === 'es' ? 'Sí' : 'Does'}</p><p>{copy.aiDoes}</p></div>
        <div class="card"><p class="eyebrow">{locale === 'es' ? 'No' : 'Does not'}</p><p>{copy.aiDoesNot}</p></div>
      </div>
    </section>

    <section id="review" class="meth-sec" aria-labelledby="rev-h">
      <h2 id="rev-h" class="t-h2">{copy.revH}</h2>
      <p class="muted">{copy.revIntro}</p>
      <ol class="meth-steps">
        {copy.revSteps.map((p) => (
          <li><span class="num t-caption" aria-hidden="true">{p.n}</span><span class="t-small">{p.texto}</span></li>
        ))}
      </ol>
    </section>

    <section id="corrections" class="meth-sec" aria-labelledby="corr-h">
      <h2 id="corr-h" class="t-h2">{copy.corrH}</h2>
      <p class="muted">{copy.corrIntro}</p>
      <ol class="changelog">
        {copy.changelog.map(([date, text]) => (
          <li><time class="num t-caption" datetime={date}>{date}</time><span class="t-small">{text}</span></li>
        ))}
      </ol>
    </section>

    <section id="coi" class="meth-sec" aria-labelledby="coi-h">
      <h2 id="coi-h" class="t-h2">{copy.coiH}</h2>
      <p>{copy.coi}</p>
    </section>

    <section id="advice" class="meth-sec" aria-labelledby="adv-h">
      <h2 id="adv-h" class="t-h2">{copy.adviceH}</h2>
      <p>{copy.advice}</p>
    </section>

    <section id="errors" class="meth-sec" aria-labelledby="err-h">
      <h2 id="err-h" class="t-h2">{copy.errH}</h2>
      <p>{copy.err}</p>
      <p class="meth-actions">
        <a class="btn btn-primary btn-sm" href={ISSUES} target="_blank" rel="noopener">{copy.errIssues} ↗</a>
        <a class="btn btn-ghost btn-sm" href={LINKEDIN} target="_blank" rel="noopener">{copy.errLinkedin} ↗</a>
      </p>
    </section>

    <section class="meth-sec" aria-labelledby="attr-h">
      <h2 id="attr-h" class="t-h3">{copy.attribH}</h2>
      <p class="t-small muted">{copy.attrib}</p>
      <p class="t-small meth-more"><a href={L('about')}>{copy.about} →</a> <a href={L('lessons.glossary')}>{copy.glossary} →</a></p>
    </section>
  </div>
</article>
<style>
  .meth { padding-top: var(--sp-4); }
  .meth-wrap { max-width: calc(var(--measure) + 2 * var(--gutter)); display: flex; flex-direction: column; gap: var(--sp-8); }
  .meth-head { display: flex; flex-direction: column; gap: var(--sp-3); }
  .meth-lede { font-size: var(--fs-read); line-height: var(--lh-read); color: var(--ink-2); }
  .meth-toc { gap: var(--sp-2); scroll-snap-type: none; margin-top: var(--sp-2); }
  .meth-toc .chip { color: var(--ink-2); }
  .meth-toc .chip:hover { color: var(--ink); border-color: var(--ink-3); }
  .meth-sec { display: flex; flex-direction: column; gap: var(--sp-3); scroll-margin-top: calc(var(--topbar-h) + 8px); }
  .meth-sec p { max-width: var(--measure); }
  .meth-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .meth-table { width: 100%; border-collapse: collapse; font-size: var(--fs-small); line-height: var(--lh-small); }
  .meth-table thead { display: none; }
