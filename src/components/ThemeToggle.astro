---
import type { Locale } from '../i18n/routes';
import { useT } from '../i18n/ui';
const { locale } = Astro.props as { locale: Locale };
const t = useT(locale);
---
<button class="theme-toggle" type="button" data-theme-toggle aria-label={t('theme.toggle')} title={t('theme.toggle')}>
  <svg class="ico-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  <svg class="ico-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
</button>
<style>
  .theme-toggle { width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; border-radius: var(--r-btn); color: var(--ink-2); }
  .theme-toggle:hover { color: var(--ink); background: var(--bg-2); }
  .ico-sun { display: none; }
  :global(:root[data-theme="dark"]) .ico-sun { display: block; }
  :global(:root[data-theme="dark"]) .ico-moon { display: none; }
</style>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
    b.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('sf-theme', next); } catch {}
      document.dispatchEvent(new CustomEvent('sf:theme', { detail: next }));
    });
  });
</script>
