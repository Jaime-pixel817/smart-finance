---
// Barra superior: wordmark · (escritorio) Hoy · Mercados · Noticias · Aprende ·
// Herramientas · Research · EN/ES · tema · Boletín. En móvil solo wordmark,
// idioma, tema y buscar; los destinos van en BottomNav.
import type { Locale } from '../i18n/routes';
import { route, otherLocale } from '../i18n/routes';
import { useT } from '../i18n/ui';
import ThemeToggle from './ThemeToggle.astro';
// `overlay` lo pone solo el home: la barra se sale del flujo y va TRANSPARENTE
// sobre el globo a sangre del hero; src/scripts/hero.ts le añade .is-solid en
// cuanto el hero deja de estar debajo, y .is-parked cuando el globo termina de
// encogerse hasta esta barra (ahí la "S" del wordmark se cambia por el globo).
const { locale, routeId, active, overlay = false } = Astro.props as { locale: Locale; routeId: string; active: string; overlay?: boolean };
const t = useT(locale);
const other = otherLocale(locale);
const home = route('home', locale);
const links: { id: string; href: string; label: string; wide?: boolean }[] = [
  { id: 'today', href: home, label: t('nav.today') },
  { id: 'markets', href: route('market', locale), label: t('nav.markets') },
  { id: 'news', href: route('news', locale), label: t('nav.news') },
  { id: 'learn', href: route('lessons', locale), label: t('nav.learn') },
  { id: 'tools', href: route('tools', locale), label: t('nav.tools') },
  { id: 'research', href: route('research', locale), label: t('nav.research') }
];
// Menú "Más": los destinos que no caben en la barra. Es un <details>, así que
// abre, cierra y navega con el teclado sin una línea de JavaScript; el script
// de abajo solo añade lo que el elemento no trae (cerrar al hacer clic fuera y
// con Escape). En el teléfono la barra no lo enseña —ahí manda BottomNav— y
// estos destinos se alcanzan por el pie y por el buscador.
const mas: { id: string; href: string; label: string }[] = [
  { id: 'portfolio', href: route('portfolio', locale), label: t('nav.portfolio') },
  { id: 'actinver', href: route('actinver', locale), label: t('nav.actinver') },
  { id: 'community', href: route('community', locale), label: t('nav.community') },
  { id: 'lessons.glossary', href: route('lessons.glossary', locale), label: t('nav.glossary') },
  { id: 'methodology', href: route('methodology', locale), label: t('nav.methodology') }
];
const masActivo = mas.some((m) => m.id === active);
let altHref = '/';
try { altHref = route(routeId, other); } catch { altHref = route('home', other); }
---
<header class:list={['topbar', overlay && 'is-overlay']}>
  <div class="container topbar-inner">
    <a class="wordmark" href={home}>
      <span class="wm-mark" aria-hidden="true">
        <span class="wm-s">S</span>
        {overlay && (
          <svg class="wm-globe" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <circle cx="12" cy="12" r="9"/>
            <ellipse cx="12" cy="12" rx="4" ry="9"/>
            <path d="M3.6 9h16.8M3.6 15h16.8"/>
          </svg>
        )}
      </span><span class="wm-text">Smart Finance</span>
    </a>
    <nav class="desk-nav" aria-label={locale === 'es' ? 'Principal' : 'Primary'}>
      {links.map((l) => (
        <a href={l.href} class:list={{ 'nav-wide': l.wide }} aria-current={l.id === active ? 'page' : undefined}>{l.label}</a>
      ))}
      <details class="more-menu" data-more>
        <summary class:list={{ 'is-active': masActivo }}>
          {t('nav.more')}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="more-panel">
          {mas.map((m) => (
            <a href={m.href} aria-current={m.id === active ? 'page' : undefined}>{m.label}</a>
          ))}
        </div>
      </details>
    </nav>
    <div class="topbar-actions">
      <a class="lang-btn" data-lang={other} href={altHref} hreflang={other} lang={other} aria-label={t('nav.lang.aria')}>{other.toUpperCase()}</a>
      <ThemeToggle locale={locale} />
      <button class="search-btn desk-only" type="button" data-search-open aria-label={t('nav.search')} title={t('nav.search')}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </button>
      <a class="btn btn-primary btn-sm desk-only" href={home + '#newsletter'}>{t('nav.newsletter')}</a>
    </div>
  </div>
</header>
<style>
  .topbar { position: sticky; top: 0; z-index: 40; height: var(--topbar-h); background: color-mix(in srgb, var(--bg-0) 88%, transparent); backdrop-filter: saturate(1.4) blur(10px); -webkit-backdrop-filter: saturate(1.4) blur(10px); border-bottom: 1px solid var(--line); }

  /* ── Modo sobre el globo (solo el home) ────────────────────────────────
     position: fixed y no sticky porque sticky sigue OCUPANDO su hueco en el
     flujo, y entonces el hero empezaría 52 px más abajo y el globo no llegaría
     al borde de arriba. Fuera del flujo, el hero arranca en y = 0 y la barra
     flota encima.
     Sobre el globo la tinta NO puede salir de los tokens normales: el fondo de
     esta barra no es la página, es el globo. Y desde que el globo se aclara en
     modo día (Hero.astro + risk-sphere.js), tampoco puede ser siempre clara —
     hueso sobre un globo de papel no se lee. Así que va en variables propias
     que se dan la vuelta con el tema; al ponerse sólida vuelven los tokens. */
  .topbar.is-overlay {
    --ov-ink: #F7F7F3;
    --ov-ink-2: #E4E4DE;
    --ov-halo: 0 1px 3px rgba(0,0,0,.7);
    --ov-marca: #35D89A;
    --ov-chip-bg: rgba(10,10,13,.5);
    --ov-chip-line: rgba(244,244,241,.22);
    position: fixed; top: 0; left: 0; right: 0;
    background: transparent; border-bottom-color: transparent;
    backdrop-filter: none; -webkit-backdrop-filter: none;
    color: var(--ov-ink);
    transition: background .25s ease, border-color .25s ease, backdrop-filter .25s ease;
  }
  :global(:root[data-theme="light"]) .topbar.is-overlay {
    --ov-ink: #101216;
    --ov-ink-2: #33363D;
    --ov-halo: 0 1px 3px rgba(255,255,255,.85);
    --ov-marca: #087248;
    --ov-chip-bg: rgba(255,255,255,.72);
    --ov-chip-line: rgba(18,19,22,.16);
  }
  .topbar.is-overlay .wordmark { color: var(--ov-ink); text-shadow: var(--ov-halo); }
  .topbar.is-overlay .wm-s { background: var(--ov-chip-bg); border-color: var(--ov-chip-line); color: var(--ov-marca); }
  .topbar.is-overlay .wm-globe { color: var(--ov-marca); }
  .topbar.is-overlay .desk-nav a, .topbar.is-overlay .lang-btn, .topbar.is-overlay .search-btn { color: var(--ov-ink-2); text-shadow: var(--ov-halo); }
  .topbar.is-overlay :global(.theme-toggle) { color: var(--ov-ink-2); }
  .topbar.is-overlay.is-solid {
    background: color-mix(in srgb, var(--bg-0) 92%, transparent);
    border-bottom-color: var(--line);
    backdrop-filter: saturate(1.4) blur(10px); -webkit-backdrop-filter: saturate(1.4) blur(10px);
    color: var(--ink);
  }
  .topbar.is-overlay.is-solid .wordmark { color: var(--ink); text-shadow: none; }
  .topbar.is-overlay.is-solid .wm-s { background: var(--bg-1); border-color: var(--line); color: var(--brand-text); }
  .topbar.is-overlay.is-solid .wm-globe { color: var(--brand-text); }
  .topbar.is-overlay.is-solid .desk-nav a, .topbar.is-overlay.is-solid .lang-btn, .topbar.is-overlay.is-solid .search-btn { color: var(--ink-2); text-shadow: none; }
  .topbar.is-overlay.is-solid :global(.theme-toggle) { color: var(--ink-2); }
  @media (prefers-reduced-motion: reduce) {
    .topbar.is-overlay { transition: none; }
    .wm-s, .wm-globe { transition: none; }
  }
  .topbar-inner { height: 100%; display: flex; align-items: center; gap: var(--sp-4); }
  .wordmark { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-serif); font-weight: 600; font-size: 1.125rem; letter-spacing: -.01em; color: var(--ink); min-height: 44px; }
  /* La "S" y el globo comparten el mismo hueco de 26 px y se cruzan: el globo
     del hero "aterriza" justo aquí. */
  .wm-mark { position: relative; width: 26px; height: 26px; flex: none; }
  .wm-s, .wm-globe { position: absolute; inset: 0; transition: opacity .28s ease, transform .28s ease; }
  .wm-s { width: 26px; height: 26px; border-radius: 7px; background: var(--bg-1); border: 1px solid var(--line); color: var(--brand-text); display: inline-grid; place-items: center; font-size: 1rem; line-height: 1; }
  .wm-globe { width: 26px; height: 26px; color: var(--brand-text); opacity: 0; transform: scale(1.5); }
  .topbar.is-parked .wm-s { opacity: 0; transform: scale(.7); }
  .topbar.is-parked .wm-globe { opacity: 1; transform: none; }
  .desk-nav { display: none; gap: 2px; margin-left: var(--sp-2); }
  .desk-nav a { padding: 0 12px; min-height: 40px; display: inline-flex; align-items: center; border-radius: var(--r-btn); font-size: var(--fs-small); font-weight: 500; color: var(--ink-2); position: relative; }
  .desk-nav a:hover { color: var(--ink); background: var(--bg-2); }
  .desk-nav a[aria-current="page"] { color: var(--ink); }
  .desk-nav a[aria-current="page"]::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: -1px; height: 2px; background: var(--brand-text); border-radius: 2px; }
  .topbar-actions { margin-left: auto; display: flex; align-items: center; gap: 2px; }
  .lang-btn { min-width: 44px; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: var(--fs-caption); font-weight: 500; letter-spacing: .06em; color: var(--ink-2); border-radius: var(--r-btn); }
  .lang-btn:hover { color: var(--ink); background: var(--bg-2); }
  .search-btn { width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; border-radius: var(--r-btn); color: var(--ink-2); }
  .search-btn:hover { color: var(--ink); background: var(--bg-2); }
  .desk-only { display: none; }
  @media (min-width: 768px) {
    .desk-nav { display: flex; }
    .desk-only { display: inline-flex; }
    .topbar-actions { gap: var(--sp-2); }
    .btn.desk-only { margin-left: var(--sp-2); }
  }
  @media (min-width: 768px) and (max-width: 1023px) { .desk-nav a { padding: 0 8px; } }
  .desk-nav .nav-wide { display: none; }
  @media (min-width: 1024px) { .desk-nav .nav-wide { display: inline-flex; } }

  /* ── Menú "Más" ────────────────────────────────────────────────────────
     <details> y no un botón con JS: abre y cierra con Enter o barra
     espaciadora, y sin JavaScript sigue funcionando (se despliega en su
     sitio). El panel va absoluto para no empujar la barra. */
  .more-menu { position: relative; }
  .more-menu summary {
    padding: 0 12px; min-height: 40px; display: inline-flex; align-items: center; gap: 4px;
    border-radius: var(--r-btn); font-size: var(--fs-small); font-weight: 500; color: var(--ink-2);
    cursor: pointer; list-style: none; white-space: nowrap;
  }
  .more-menu summary::-webkit-details-marker { display: none; }
  .more-menu summary:hover { color: var(--ink); background: var(--bg-2); }
  .more-menu summary.is-active { color: var(--ink); }
  .more-menu[open] summary svg { transform: rotate(180deg); }
  .more-menu summary svg { transition: transform .18s ease; }
  @media (prefers-reduced-motion: reduce) { .more-menu summary svg { transition: none; } }
  .more-panel {
    position: absolute; top: calc(100% + 6px); right: 0; z-index: 50; min-width: 200px;
    display: flex; flex-direction: column; padding: var(--sp-2);
    background: var(--bg-1); border: 1px solid var(--line); border-radius: var(--r-card); box-shadow: var(--shadow-sheet);
  }
  .more-panel a {
    padding: 0 var(--sp-3); min-height: 40px; display: flex; align-items: center;
    border-radius: var(--r-btn); font-size: var(--fs-small); color: var(--ink-2); white-space: nowrap;
  }
  .more-panel a:hover { color: var(--ink); background: var(--bg-2); }
  .more-panel a[aria-current="page"] { color: var(--ink); background: var(--brand-wash); }
  /* Sobre el globo del home la barra es transparente: el panel NO puede serlo. */
  .topbar.is-overlay .more-menu summary { color: var(--ov-ink-2); text-shadow: var(--ov-halo); }
  .topbar.is-overlay.is-solid .more-menu summary { color: var(--ink-2); text-shadow: none; }
</style>

<script>
  // Lo único que <details> no trae: cerrarse al hacer clic fuera y con Escape.
  const menu = document.querySelector<HTMLDetailsElement>('[data-more]');
  if (menu) {
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    menu.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key !== 'Escape' || !menu.open) return;
      menu.open = false;
      menu.querySelector('summary')?.focus();
    });
  }
</script>
