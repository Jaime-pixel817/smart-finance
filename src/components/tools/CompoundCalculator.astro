---
// Calculadora de interés compuesto. Nació dentro de la lección "Interés
// simple vs. compuesto" y ahora vive aquí porque la comparten dos superficies:
//   - la lección (<CompoundCalculator /> desde el MDX, variante "lesson");
//   - la herramienta /tools/interes-compuesto (variante "tool").
// La lección la importa desde este archivo: no hay dos copias del widget, ni
// dos copias de la fórmula (esa vive en src/lib/finance/compound.mjs y la
// pinta src/scripts/compound.ts). Sin JavaScript queda el resumen con los
// valores del ejemplo.
import type { Locale } from '../../i18n/routes';
import { useT } from '../../i18n/ui';
interface Props { locale?: Locale; variant?: 'lesson' | 'tool' }
const p = Astro.url.pathname;
// Dentro de un MDX el componente se usa sin props: el idioma sale de la ruta.
const locale: Locale = Astro.props.locale ?? (p === '/es' || p.startsWith('/es/') ? 'es' : 'en');
const variant = Astro.props.variant ?? 'lesson';
const esTool = variant === 'tool';
const t = useT(locale);
---
<div class="lesson-widget" class:list={{ 'tool-widget': esTool }} data-widget="compound" data-locale={locale}
  data-tpl={t('calc.summary_tpl')} data-years-unit={t('calc.years')} data-gain-tpl={t('tool.compound.gain_tpl')}
  data-url-state={esTool ? '' : undefined}>
  {esTool ? (
    <div class="tool-result">
      <p class="eyebrow">{t('tool.compound.result')}</p>
      <p class="tool-big num" data-lw-big aria-live="polite">$589,020</p>
      <p class="t-small muted" data-lw-gain>{t('tool.compound.gain')}</p>
    </div>
  ) : (
    <p class="eyebrow">{t('calc.eyebrow')}</p>
  )}
  <div class="lw-controls">
    <div class="lw-control">
      <label for="lwMonthly">{t('calc.monthly')}</label>
      <output for="lwMonthly" id="lwMonthlyOut" class="num">$1,000</output>
      <input type="range" id="lwMonthly" min="200" max="5000" step="100" value="1000" data-lw="monthly" data-param="m">
    </div>
    <div class="lw-control">
      <label for="lwRate">{t('calc.rate')}</label>
      <output for="lwRate" id="lwRateOut" class="num">8%</output>
      <input type="range" id="lwRate" min="4" max="12" step="0.5" value="8" data-lw="rate" data-param="r">
    </div>
    <div class="lw-control">
      <label for="lwYears">{t('calc.years')}</label>
      <output for="lwYears" id="lwYearsOut" class="num">20</output>
      <input type="range" id="lwYears" min="1" max="30" step="1" value="20" data-lw="years" data-param="y">
    </div>
  </div>
  <div class="lw-chart">
    <svg viewBox="0 0 600 200" preserveAspectRatio="none" role="img" aria-label={t('calc.chartAria')} data-lw-svg>
      <g class="lw-grid" data-lw-grid></g>
      <path class="lw-area" data-lw-area d=""></path>
      <path class="lw-line lw-contrib" data-lw-contrib d=""></path>
      <path class="lw-line lw-compound" data-lw-compound d=""></path>
    </svg>
    <div class="lw-yticks t-caption num" data-lw-yticks aria-hidden="true"></div>
    <div class="lw-xticks t-caption num" data-lw-xticks aria-hidden="true"></div>
  </div>
  <p class="lw-legend t-caption">
    <span class="lw-key"><span class="lw-dot lw-dot-contrib" aria-hidden="true"></span>{t('calc.contrib')}</span>
    <span class="lw-key"><span class="lw-dot lw-dot-compound" aria-hidden="true"></span>{t('calc.compound')}</span>
  </p>
  <p class="lw-summary" data-lw-summary aria-live="polite">{t('calc.summary')}</p>
  <p class="lw-note t-caption faint">{t('calc.note')}</p>
</div>
<script src="../../scripts/compound.ts"></script>
<style is:global>
  .lesson-widget { background: var(--bg-1); border: 1px solid var(--line); border-radius: var(--r-card); padding: var(--card-pad); margin: var(--sp-6) 0; box-shadow: var(--shadow-1); }
  .lesson-body .lesson-widget p { margin: 0; }
  .lw-controls { display: grid; gap: var(--sp-4); margin: var(--sp-4) 0 var(--sp-4); }
  @media (min-width: 640px) { .lw-controls { grid-template-columns: repeat(3, 1fr); } }
  .lw-control { display: grid; grid-template-columns: 1fr auto; align-items: baseline; gap: 4px 10px; }
  .lw-control label { font-size: var(--fs-small); color: var(--ink-2); }
  .lw-control output { font-size: var(--fs-small); color: var(--ink); text-align: right; }
  .lw-control input[type="range"] { grid-column: 1 / -1; width: 100%; margin: 0; accent-color: var(--brand-fill); height: 44px; }
  .lw-chart { position: relative; height: 200px; padding: 0 0 18px 0; }
  .lw-chart svg { width: 100%; height: calc(100% - 18px); display: block; overflow: visible; }
  .lw-grid line { stroke: var(--line); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .lw-area { fill: var(--brand-fill); opacity: .12; }
  .lw-line { fill: none; stroke-width: 2; vector-effect: non-scaling-stroke; stroke-linejoin: round; stroke-linecap: round; }
  .lw-contrib { stroke: var(--ink-3); stroke-dasharray: 5 4; stroke-width: 1.5; }
  .lw-compound { stroke: var(--brand-text); }
  .lw-yticks { position: absolute; left: 0; top: 0; height: calc(100% - 18px); width: 100%; pointer-events: none; color: var(--ink-3); }
  .lw-yticks span { position: absolute; left: 0; transform: translateY(-100%); padding: 0 0 2px; background: color-mix(in srgb, var(--bg-1) 85%, transparent); }
  .lw-xticks { position: absolute; left: 0; right: 0; bottom: 0; display: flex; justify-content: space-between; color: var(--ink-3); }
  .lw-legend { display: flex; gap: var(--sp-4); flex-wrap: wrap; margin-top: var(--sp-3) !important; color: var(--ink-2); }
  .lw-key { display: inline-flex; align-items: center; gap: 7px; }
  .lw-dot { width: 14px; height: 3px; border-radius: 2px; display: inline-block; }
  .lw-dot-contrib { background: var(--ink-3); }
  .lw-dot-compound { background: var(--brand-text); }
  .lesson-body .lw-summary { margin-top: var(--sp-3); padding-top: var(--sp-3); border-top: 1px solid var(--line); font-size: var(--fs-body); color: var(--ink); font-variant-numeric: tabular-nums; }
  .lesson-body .lw-note { margin-top: var(--sp-2); }
  /* Variante herramienta: el resultado manda, y el resumen y la nota pasan a
     ser el pie de la tarjeta (dentro de la lección el orden es el contrario). */
  .tool-widget { margin: 0; }
  .tool-widget .lw-summary { margin-top: var(--sp-3); padding-top: var(--sp-3); border-top: 1px solid var(--line); font-variant-numeric: tabular-nums; }
  .tool-widget .lw-note { margin-top: var(--sp-2); }
</style>
