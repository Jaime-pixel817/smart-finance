---
// La hoja donde sale la respuesta de Smart Finance AI. Una por página, vacía
// hasta que alguien toca un botón "Explícame esto".
//
// role=dialog + aria-modal, cierra con ✕, con el fondo y con Esc, atrapa el
// foco mientras está abierta y lo devuelve al botón al cerrar (mismo trato que
// GlossarySheet). El cuerpo va en un aria-live="polite": la respuesta tarda
// segundos en llegar y quien usa lector de pantalla tiene que enterarse de que
// llegó sin ir a buscarla.
//
// La ETIQUETA de IA no es letra chica ni está detrás de un "leer más": está
// escrita en la propia hoja, encima del pliegue, con la fecha del dato y el
// enlace a /methodology. Es la regla del sitio.
import '../../styles/ia.css';
import type { Locale } from '../../i18n/routes';
import { route } from '../../i18n/routes';
import { useT, type UIKey } from '../../i18n/ui';

const { locale } = Astro.props as { locale: Locale };
const t = useT(locale);
const strings = {
  loading: t('ia.loading'), loadingLong: t('ia.loading.long'), error: t('ia.error'),
  retry: t('ia.retry'), used: t('ia.used'), sources: t('ia.sources'), asof: t('ia.asof'),
  lesson: t('ia.lesson'), questionsTitle: t('ia.questions.title'), title: t('ia.title'),
  disclosure: t('ia.disclosure'), disclosureFixed: t('ia.disclosure.fixed'),
  limit: t('ia.limit'), explain: t('ia.explain'), seleccion: t('ia.seleccion')
};
// Tres preguntas sugeridas por CONTEXTO: en la ficha se pregunta por el
// movimiento, en la lección por el ejemplo, en la noticia por el efecto. Las
// escribe el sitio (src/i18n/ui.ts) y viajan como texto de una pregunta
// normal; hay una prueba que verifica que ninguna dispara el rechazo de
// consejo.
const sug = (tipo: string) => [1, 2, 3].map((n) => t(`ia.sug.${tipo}.${n}` as UIKey));
const sugeridas: Record<string, string[]> = {
  activo: sug('activo'), grafica: sug('activo'), leccion: sug('leccion'),
  noticia: sug('noticia'), termino: sug('termino'), reporte: sug('reporte'), reto: sug('reto')
};
---
<div class="ia-sheet" id="ia-sheet" role="dialog" aria-modal="true" aria-labelledby="ia-sheet-title"
  data-locale={locale} data-strings={JSON.stringify(strings)} data-sugeridas={JSON.stringify(sugeridas)}
  data-metodologia={route('methodology', locale)} hidden>
  <div class="ia-sheet-backdrop" data-ia-close></div>
  <div class="ia-sheet-panel" tabindex="-1">
    <button type="button" class="ia-sheet-close" data-ia-close aria-label={t('ia.close')}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
        stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>

    <p class="eyebrow ia-eyebrow">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M12 3.5l1.7 4.3 4.3 1.7-4.3 1.7L12 15.5l-1.7-4.3L6 9.5l4.3-1.7z"></path>
      </svg>
      <span>{t('ia.title')}</span>
    </p>
    <h2 id="ia-sheet-title" class="ia-sheet-title"></h2>

    <!-- Todo lo que cambia vive aquí dentro, y lo anuncia solo. -->
    <div class="ia-cuerpo" aria-live="polite" aria-busy="false"></div>

    <!-- Tres preguntas sugeridas por contexto; los chips los pinta el guion. -->
    <div class="ia-sugeridas" hidden>
      <p class="t-caption faint">{t('ia.sug.title')}</p>
      <div class="ia-sug-chips"></div>
    </div>

    <!-- La caja de preguntar. Es opcional y lo dice: no es un chat. -->
    <form class="ia-ask" hidden>
      <label class="t-caption faint" for="ia-ask-input">{t('ia.ask')}</label>
      <div class="ia-ask-row">
        <input id="ia-ask-input" type="text" maxlength="200" autocomplete="off"
          placeholder={t('ia.ask.placeholder')} />
        <button type="submit" class="btn btn-ghost btn-sm">{t('ia.ask.send')}</button>
      </div>
    </form>

    <p class="ia-disclosure">
      <span><strong class="ia-disclosure-txt">{t('ia.disclosure')}</strong></span>
      <span class="ia-asof"></span>
      <span><a href={route('methodology', locale)}>{t('ia.how')} →</a></span>
    </p>
  </div>
</div>
<!--
  El guion de la IA se carga SOLO cuando alguien la usa.

  Esta hoja vive ahora en Base.astro, o sea en las 100 páginas del sitio. Con un
  `<script src>` normal, su código entraba en el paquete de TODAS —incluido el
  home, que se lo comía sin que nadie tocara nada— y el presupuesto de
  Lighthouse del home se pasó por 1,912 bytes (189,304 contra 187,392). Es el
  mismo error que ya se cometió con los avisos contextuales, anotado en
  CLAUDE.md: lo que va en el layout se paga en todas partes.

  Así que aquí solo queda este arranque diminuto, que espera al primer gesto de
  verdad —tocar un botón de IA, o soltar una selección de texto dentro de un
  bloque de lectura— y entonces hace un `import()` dinámico. Vite lo parte en su
  propio trozo, que no se descarga hasta ese momento: quien no usa la IA no
  paga ni un byte de ella. Lo que estaba pendiente al cargar (el botón que se
  tocó, o que había una selección) se le deja escrito en `window.__iaPend`, y el
  módulo lo atiende nada más arrancar.
-->
<script>
  let cargando = false;
  function cargar(pendiente: unknown) {
    if (cargando) return;
    cargando = true;
    (window as unknown as { __iaPend?: unknown }).__iaPend = pendiente;
    import('../../scripts/ia.ts');
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.ia-btn[data-ia]');
    if (btn) { e.preventDefault(); cargar(btn); }
  });

  /** ¿Hay una selección de lectura lo bastante larga como para ofrecerla? */
  function haySeleccion() {
    const sel = window.getSelection();
    if (!sel || sel.isCollapsed) return false;
    if (sel.toString().replace(/\s+/g, ' ').trim().length < 12) return false;
    const n = sel.anchorNode;
    const el = n instanceof Element ? n : n?.parentElement;
    return !!(el && el.closest('[data-ia-seleccion]'));
  }
  function mirarSeleccion() {
    if (!cargando && haySeleccion()) cargar('sel');
  }

  // Con el dedo o el ratón, al soltar. Y por `selectionchange` además, que es
  // lo ÚNICO que se entera de una selección hecha con el teclado
  // (Shift+flechas): sin esto, quien no usa ratón no llegaba nunca a la
  // burbuja, y el módulo que la pinta no se habría cargado jamás.
  document.addEventListener('pointerup', () => window.setTimeout(mirarSeleccion, 60));
  let reloj = 0;
  document.addEventListener('selectionchange', () => {
    window.clearTimeout(reloj);
    reloj = window.setTimeout(mirarSeleccion, 350);
  });
</script>
