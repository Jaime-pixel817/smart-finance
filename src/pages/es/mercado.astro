---
import Base from '../../layouts/Base.astro';
import MarketList from '../../components/market/MarketList.astro';
import { SITE } from '../../i18n/routes';
import { ogPropia } from '../../lib/og';
import { useT } from '../../i18n/ui';
const t = useT('es');
const title = 'Mercados hoy: índices, acciones, divisas y cripto — Smart Finance';
const description = 'ETF de índices, cuatro acciones, el VIX, seis pares de divisas y cuatro criptomonedas, cada uno con su gráfica táctil y su ficha. Los precios se actualizan cada 15 minutos, nunca “en vivo”.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: SITE + '/es/mercado',
  inLanguage: 'es-MX',
  isPartOf: { '@type': 'WebSite', name: 'Smart Finance', url: SITE + '/' }
};
---
<Base locale="es" routeId="market" active="markets" title={title} description={description}
  ia={{ tipo: 'activo', id: 'spy', rango: '1D', sobre: t('ia.ctx.market') }}
  ogImage={ogPropia('market', 'es')} ogImageAlt="Smart Finance — Mercado: índices, acciones, divisas y cripto" jsonLd={jsonLd}>
  <MarketList locale="es" />
</Base>
