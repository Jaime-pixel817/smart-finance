---
import Base from '../../layouts/Base.astro';
import Home from '../../components/home/Home.astro';
import { useT } from '../../i18n/ui';
const t = useT('es');
---
<Base locale="es" routeId="home" active="today" heroOverlay
  ia={{ tipo: 'activo', id: 'spy', rango: '1D', sobre: t('ia.ctx.market') }}
  title="Smart Finance — Mercados y dinero, explicados para jóvenes"
  description={t('site.desc')}
  ogImageAlt="Smart Finance — finanzas que sí se entienden, por Jaime Sandoval Ricaño">
  <Home locale="es" />
</Base>
