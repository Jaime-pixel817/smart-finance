---
// Gemela en español de /news-read.
import Base from '../../layouts/Base.astro';
import NewsRead from '../../components/news/NewsRead.astro';
import { useT } from '../../i18n/ui';
import { ogPropia } from '../../lib/og';
const t = useT('es');
---
<!-- og:image: la del ÍNDICE de noticias, no la de la noticia. Esta página
     pinta en el navegador la nota que pida la URL, así que en el build no se
     sabe cuál es y no puede haber una tarjeta propia. -->
<Base locale="es" routeId="news.read" active="news" title={t('news.h1') + ' — Smart Finance'} description={t('news.sub')}
  ogImage={ogPropia('news', 'es')} ogImageAlt="Smart Finance — Noticias explicadas">
  <meta slot="head" name="robots" content="noindex, follow">
  <NewsRead locale="es" />
</Base>
