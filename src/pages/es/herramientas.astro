---
import Base from '../../layouts/Base.astro';
import ToolsIndex from '../../components/tools/ToolsIndex.astro';
import { SITE, route } from '../../i18n/routes';
import { ogPropia } from '../../lib/og';
import { ui } from '../../i18n/ui';
const t = ui.es;
const title = 'Herramientas: el reto diario y tres calculadoras — Smart Finance';
const description = 'Un reto nuevo cada día con gráficas reales y tres calculadoras gratis con tus propios números: en cuánto se convierte un ahorro mensual con interés compuesto, cuánto te come la inflación de lo que tienes, y si los CETES, tu cuenta o el efectivo conservan lo que tu dinero compra.';
const tools = ['challenge', 'tool.interes', 'tool.inflacion', 'tool.cetes'];
const names = [t['tools.reto'], t['tools.compound'], t['tools.inflation'], t['tools.cetes']];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Herramientas',
  description,
  url: SITE + '/es/herramientas',
  inLanguage: 'es-MX',
  isPartOf: { '@type': 'WebSite', name: 'Smart Finance', url: SITE + '/' },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: tools.length,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    itemListElement: tools.map((id, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE + route(id, 'es'), name: names[i] }))
  }
};
---
<Base locale="es" routeId="tools" active="tools" title={title} description={description}
  ia={{ tipo: 'termino', id: 'interes-compuesto', sobre: t['ia.ctx.tools'] }}
  ogImage={ogPropia('tools', 'es')} ogImageAlt="Smart Finance — Herramientas: tres calculadoras con tus propios números" jsonLd={jsonLd}>
  <ToolsIndex locale="es" />
</Base>
