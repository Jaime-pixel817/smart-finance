---
import Base from '../../../layouts/Base.astro';
import ToolPage from '../../../components/tools/ToolPage.astro';
import InflationTool from '../../../components/tools/InflationTool.astro';
import { SITE } from '../../../i18n/routes';
const title = '¿Cuánto me come la inflación? Calculadora en pesos — Smart Finance';
const description = 'Pon lo que algo te cuesta hoy, una inflación anual y los años: mira cuánto costará lo mismo, cuánto poder de compra se fue, y cómo se compara el dinero parado contra el dinero a la tasa de referencia.';
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'WebPage', name: title, description,
  url: SITE + '/es/herramientas/inflacion', inLanguage: 'es-MX',
  isPartOf: { '@type': 'WebSite', name: 'Smart Finance', url: SITE + '/' },
  mainEntity: { '@type': 'WebApplication', name: 'Calculadora de inflación', applicationCategory: 'FinanceApplication', operatingSystem: 'Any', browserRequirements: 'Requiere JavaScript', offers: { '@type': 'Offer', price: '0', priceCurrency: 'MXN' } }
};
const learn = [
  'La inflación no te saca dinero de la cuenta: le saca cosas a tu dinero. El billete es el mismo, el mandado es más chico.',
  'El dinero parado al 0 % no es neutral, es una pérdida lenta — y esa pérdida se compone igual que los intereses, solo que en tu contra.',
  'Lo que importa es la tasa menos la inflación. Un número que crece mientras los precios crecen más rápido sigue yendo hacia atrás.'
];
---
<Base locale="es" routeId="tool.inflacion" active="tools" title={title} description={description} jsonLd={jsonLd}>
  <ToolPage locale="es" eyebrow="Herramienta" title="¿Cuánto me come la inflación?" lessonRouteId="lesson.inflacion" lessonLabel="Qué es la inflación y cómo te afecta"
    lede="Empieza con algo que de verdad compras —tacos y refresco, $100— y mira cuánto costará lo mismo después, y qué alcanzaría a comprar tu dinero."
    learn={learn}>
    <InflationTool locale="es" />
  </ToolPage>
</Base>
