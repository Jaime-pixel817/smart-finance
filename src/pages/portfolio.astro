---
// /portfolio — las posiciones personales de Jaime, con dinero real, en inglés.
// El contenido lo pinta Cartera.astro desde src/data/portfolio.json.
import Base from '../layouts/Base.astro';
import Cartera from '../components/portfolio/Cartera.astro';
import { SITE } from '../i18n/routes';
import { ogPropia } from '../lib/og';
import { useC } from '../i18n/cartera';
import { PORTFOLIO } from '../lib/portfolio/data';
const c = useC('en');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Portfolio',
  description: c.portfolio.desc,
  url: SITE + '/portfolio',
  inLanguage: 'en',
  dateModified: PORTFOLIO.actualizado,
  isPartOf: { '@type': 'WebSite', name: 'Smart Finance', url: SITE + '/' },
  author: { '@type': 'Person', name: 'Jaime Sandoval Ricaño', url: SITE + '/about' },
  publisher: { '@type': 'Organization', name: 'Smart Finance', '@id': SITE + '/#organization' }
};
---
<Base locale="en" routeId="portfolio" active="portfolio" title={c.portfolio.title} description={c.portfolio.desc} jsonLd={jsonLd}
  ogImage={ogPropia('portfolio', 'en')} ogImageAlt="Smart Finance — My portfolio: the positions and the thesis behind each one">
  <Cartera locale="en" id="portfolio" />
</Base>
