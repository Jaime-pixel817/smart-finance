---
import Base from '../layouts/Base.astro';
import MarketList from '../components/market/MarketList.astro';
import { SITE } from '../i18n/routes';
const title = 'Markets today: indexes, stocks, currencies and crypto — Smart Finance';
const description = 'Index ETFs, four stocks, the VIX, six currency pairs and four cryptocurrencies, each with its own touch chart and card. Prices refresh every 15 minutes, never “live”.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: SITE + '/market',
  inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', name: 'Smart Finance', url: SITE + '/' }
};
---
<Base locale="en" routeId="market" active="markets" title={title} description={description}
  ogImage={SITE + '/og-market.jpg'} ogImageAlt="Smart Finance — Markets: stocks, currencies and crypto" jsonLd={jsonLd}>
  <MarketList locale="en" />
</Base>
