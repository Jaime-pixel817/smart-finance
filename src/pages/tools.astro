---
import Base from '../layouts/Base.astro';
import ToolsIndex from '../components/tools/ToolsIndex.astro';
import { SITE, route } from '../i18n/routes';
import { ogPropia } from '../lib/og';
import { ui } from '../i18n/ui';
const t = ui.en;
const title = 'Tools: the daily challenge and three calculators — Smart Finance';
const description = 'A new daily challenge on real charts, plus three free calculators with your own numbers: what a monthly saving turns into with compound interest, how much inflation eats from what you have, and whether CETES, your bank account or cash keep what your money buys.';
const tools = ['challenge', 'tool.interes', 'tool.inflacion', 'tool.cetes'];
const names = [t['tools.reto'], t['tools.compound'], t['tools.inflation'], t['tools.cetes']];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Tools',
  description,
  url: SITE + '/tools',
  inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', name: 'Smart Finance', url: SITE + '/' },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: tools.length,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    itemListElement: tools.map((id, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE + route(id, 'en'), name: names[i] }))
  }
};
---
<Base locale="en" routeId="tools" active="tools" title={title} description={description}
  ia={{ tipo: 'termino', id: 'interes-compuesto', sobre: t['ia.ctx.tools'] }}
  ogImage={ogPropia('tools', 'en')} ogImageAlt="Smart Finance — Tools: three calculators with your own numbers" jsonLd={jsonLd}>
  <ToolsIndex locale="en" />
</Base>
