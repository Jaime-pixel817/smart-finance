---
// /news — índice de las noticias explicadas.
import Base from '../layouts/Base.astro';
import NewsIndex from '../components/news/NewsIndex.astro';
import { SITE } from '../i18n/routes';
import { NEWS } from '../data/news';
const title = 'News, explained: what happened and why it matters — Smart Finance';
const description = 'Market and economy news explained in plain words for students in Mexico and Canada: what happened, why it matters to you, and what it touched in the markets. Every story is reviewed by a person before it goes up.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'News, explained',
  description,
  url: SITE + '/news',
  inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', name: 'Smart Finance', url: SITE + '/' },
  publisher: { '@type': 'Organization', name: 'Smart Finance', '@id': SITE + '/#organization' },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: NEWS.length,
    itemListElement: NEWS.map((n, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE + '/news/' + n.slug, name: n.en.titulo }))
  }
};
---
<Base locale="en" routeId="news" active="news" title={title} description={description} jsonLd={jsonLd}>
  <NewsIndex locale="en" />
</Base>
