---
// Lección en inglés: una página estática por MDX de src/content/lessons/en.
import Base from '../../layouts/Base.astro';
import LessonArticle from '../../components/learn/LessonArticle.astro';
import { getLessons, type Lesson } from '../../data/lessons';
import { lessonJsonLd } from '../../data/lesson-jsonld';
import { ogPropia } from '../../lib/og';

export async function getStaticPaths() {
  const all = await getLessons('en');
  return all.map((lesson) => ({ params: { slug: lesson.slug }, props: { lesson, all } }));
}
const { lesson, all } = Astro.props as { lesson: Lesson; all: Lesson[] };
const d = lesson.entry.data;
---
<Base locale="en" routeId={lesson.routeId} active="learn" title={d.title + ' — Smart Finance'} description={d.description} ogType="article"
  ogImage={ogPropia('lesson-' + lesson.slug, 'en')} ogImageAlt={d.title + ' — Smart Finance lesson'} jsonLd={lessonJsonLd('en', lesson)}>
  <LessonArticle locale="en" lesson={lesson} all={all} />
</Base>
